{
  "$ref": "#/definitions/articles",
  "definitions": {
    "articles": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "category": {
          "type": "string",
          "enum": [
            "symptom",
            "basics",
            "cleaning",
            "career",
            "buying",
            "energy-saving"
          ]
        },
        "symptoms": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "products": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "difficulty": {
          "type": "string",
          "enum": [
            "beginner",
            "intermediate"
          ],
          "default": "beginner"
        },
        "risk": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "recommendedCta": {
          "type": "string",
          "enum": [
            "products",
            "contractor",
            "jobs",
            "learn"
          ]
        },
        "pubDate": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "integer",
              "format": "unix-time"
            }
          ]
        },
        "$schema": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "description",
        "category",
        "risk",
        "recommendedCta",
        "pubDate"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}