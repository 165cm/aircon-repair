---
import { affiliate } from "@data/affiliate";
import { sitePath } from "@utils/paths";
import "@styles/global.css";

type Props = {
  title: string;
  description: string;
  canonical?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
};

const { title, description, canonical, jsonLd } = Astro.props;
const pageTitle = title === affiliate.siteName ? title : `${title} | ${affiliate.siteName}`;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, affiliate.siteUrl).toString();
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={affiliate.siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={new URL("/images/aircon-hero.png", affiliate.siteUrl).toString()} />
    <meta name="twitter:card" content="summary_large_image" />
    {
      jsonLd && (
        <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
      )
    }
  </head>
  <body>
    <header class="site-header">
      <div class="container nav">
        <a class="brand" href={sitePath("/")}>
          <span class="brand-mark" aria-hidden="true">冷</span>
          <span>{affiliate.siteName}</span>
        </a>
        <nav class="nav-links" aria-label="主要ナビゲーション">
          <a href={sitePath("/diagnosis/")}>症状診断</a>
          <a href={sitePath("/by-size/")}>畳数で選ぶ</a>
          <a href={sitePath("/basics/")}>基礎知識</a>
          <a href={sitePath("/cleaning-prevention/")}>掃除・予防</a>
          <a href={sitePath("/products/")}>商品比較</a>
          <a href={sitePath("/jobs/")}>求人・副業</a>
          <a href={sitePath("/disclaimer/")}>広告表記</a>
        </nav>
      </div>
    </header>
    <div class="ad-disclosure">
      <div class="container">{affiliate.disclosure}</div>
    </div>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-grid">
        <div>
          <h2>{affiliate.siteName}</h2>
          <p>エアコンの不調で困った人が、安全に切り分け、必要な商品や専門相談へ進めるための初心者向けサイトです。</p>
        </div>
        <div class="footer-links">
          <strong>コンテンツ</strong>
          <a href={sitePath("/diagnosis/")}>症状診断</a>
          <a href={sitePath("/by-size/")}>畳数で選ぶ</a>
          <a href={sitePath("/products/")}>商品比較</a>
          <a href={sitePath("/jobs/")}>求人・副業</a>
        </div>
        <div class="footer-links">
          <strong>運営情報</strong>
          <a href={sitePath("/disclaimer/")}>広告表記・免責</a>
          <a href={sitePath("/about/")}>運営者・編集方針</a>
          <a href={sitePath("/sitemap.xml")}>サイトマップ</a>
        </div>
      </div>
    </footer>
  </body>
</html>
