---
import { affiliate, analytics } from "@data/affiliate";
import { absoluteUrl, sitePath } from "@utils/paths";
import ChatFloat from "@components/ChatFloat.astro";
import "@styles/global.css";

type Breadcrumb = { label: string; href?: string };

type Props = {
  title: string;
  description: string;
  canonical?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  ogImage?: string;
  breadcrumbs?: Breadcrumb[];
};

const { title, description, canonical, jsonLd, ogImage, breadcrumbs } = Astro.props;
const pageTitle = title === affiliate.siteName ? title : `${title} | ${affiliate.siteName}`;
const canonicalUrl = canonical ?? absoluteUrl(Astro.url.pathname);

// インラインチャットがあるページはフローティングを非表示（重複ID回避）
const noFloatPages = ["/diagnosis", ""];  // "" = トップ(/)
const normalizedPath = Astro.url.pathname.replace(/\/$/, "").replace(import.meta.env.BASE_URL.replace(/\/$/, ""), "");
const showChatFloat = !noFloatPages.includes(normalizedPath);
const ogImageUrl = ogImage ? absoluteUrl(ogImage) : absoluteUrl("/images/trust-hero-aircon-check.webp");

const breadcrumbJsonLd = breadcrumbs && breadcrumbs.length > 0
  ? {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: breadcrumbs.map((crumb, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: crumb.label,
        ...(crumb.href ? { item: absoluteUrl(crumb.href) } : {})
      }))
    }
  : null;

const footerSiteMap = [
  {
    id: "symptoms",
    heading: "症状から調べる",
    links: [
      { label: "症状別診断", href: "/diagnosis/" },
      { label: "冷えない・効きが悪い", href: "/articles/not-cooling/" },
      { label: "水漏れしている", href: "/articles/water-leak/" },
      { label: "異音がする", href: "/articles/strange-noise/" },
      { label: "暖房が効かない", href: "/articles/heating-not-working/" },
      { label: "リモコンが効かない", href: "/articles/remote-not-working/" },
      { label: "修理を呼ぶ目安", href: "/articles/call-contractor/" }
    ]
  },
  {
    id: "buying",
    heading: "買い替え・備え",
    links: [
      { label: "畳数でエアコンを選ぶ", href: "/by-size/" },
      { label: "エアコンメーカー比較", href: "/articles/aircon-maker-compare/" },
      { label: "取り付け工事費の確認", href: "/articles/installation-cost/" },
      { label: "6畳用の選び方", href: "/articles/aircon-6jou-choose/" },
      { label: "10畳用の選び方", href: "/articles/aircon-10jou-choose/" },
      { label: "14畳用の選び方", href: "/articles/aircon-14jou-choose/" },
      { label: "補助用品・本体候補", href: "/products/" }
    ]
  },
  {
    id: "learn",
    heading: "基礎知識・掃除予防",
    links: [
      { label: "エアコンの基礎知識", href: "/basics/" },
      { label: "掃除・故障予防まとめ", href: "/cleaning-prevention/" },
      { label: "フィルター掃除の基本", href: "/articles/filter-cleaning/" },
      { label: "掃除スプレーの注意点", href: "/articles/cleaning-spray-risk/" },
      { label: "室外機まわりの確認", href: "/articles/outdoor-unit-check/" },
      { label: "ドレンホースの確認", href: "/articles/drain-hose/" },
      { label: "電気代が高い時の確認", href: "/articles/electric-bill-high/" }
    ]
  },
  {
    id: "site-info",
    heading: "サイト情報",
    links: [
      { label: "記事一覧", href: "/articles/" },
      { label: "運営者・編集方針", href: "/about/" },
      { label: "広告表記・免責事項", href: "/disclaimer/" },
      { label: "プライバシーポリシー", href: "/privacy/" },
      { label: "お問い合わせ", href: "/contact/" },
      { label: "求人・副業入門", href: "/jobs/" },
      { label: "XMLサイトマップ（検索エンジン用）", href: "/sitemap.xml" }
    ]
  }
];
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {analytics.googleSiteVerification && (
      <meta name="google-site-verification" content={analytics.googleSiteVerification} />
    )}
    {analytics.bingSiteVerification && (
      <meta name="msvalidate.01" content={analytics.bingSiteVerification} />
    )}
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={affiliate.siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={sitePath("/favicon.png")} type="image/png" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    {breadcrumbJsonLd && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />}
    {analytics.ga4MeasurementId && (
      <Fragment>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${analytics.ga4MeasurementId}`}></script>
        <script is:inline set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${analytics.ga4MeasurementId}');`} />
      </Fragment>
    )}
    {analytics.clarityProjectId && (
      <script is:inline set:html={`(function(c,l,a,r,i,t,y){c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);})(window,document,"clarity","script","${analytics.clarityProjectId}");`} />
    )}
  </head>
  <body>
    <header class="site-header">
      <div class="container nav">
        <a class="brand" href={sitePath("/")}>
          <img class="brand-logo" src={sitePath("/images/brand/aircon-hokenshitsu-logo.png")} alt={affiliate.siteName} width="860" height="144" />
        </a>
        <nav class="nav-links" aria-label="主要ナビゲーション">
          <a class="nav-consult-link" href={sitePath("/#chat-title")} data-cvr-action="header_consult_click" data-action-kind="safe">3分相談</a>
          <a href={sitePath("/by-size/")}>畳数で選ぶ</a>
          <a href={sitePath("/basics/")}>基礎知識</a>
          <a href={sitePath("/cleaning-prevention/")}>掃除・予防</a>
          <a href={sitePath("/products/")}>商品比較</a>
          <a href={sitePath("/jobs/")}>求人・副業</a>
          <a href={sitePath("/disclaimer/")}>広告表記</a>
        </nav>
      </div>
    </header>
    <div class="ad-disclosure">
      <div class="container">{affiliate.disclosure}</div>
    </div>
    {breadcrumbs && breadcrumbs.length > 0 && (
      <nav aria-label="パンくずリスト" class="breadcrumb">
        <div class="container">
          <ol class="breadcrumb-list">
            {breadcrumbs.map((crumb, i) => (
              <li>
                {crumb.href
                  ? <a href={sitePath(crumb.href)}>{crumb.label}</a>
                  : <span aria-current="page">{crumb.label}</span>}
                {i < breadcrumbs.length - 1 && <span class="breadcrumb-sep" aria-hidden="true">›</span>}
              </li>
            ))}
          </ol>
        </div>
      </nav>
    )}
    <main>
      <slot />
    </main>
    <script is:inline>
      if (!window.__airconCvrTrackingReady) {
        window.__airconCvrTrackingReady = true;
        document.addEventListener("click", (event) => {
          const target = event.target instanceof Element ? event.target.closest("[data-cvr-action]") : null;
          if (!target) return;

          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push({
            event: "cvr_action_click",
            action: target.getAttribute("data-cvr-action"),
            action_kind: target.getAttribute("data-action-kind"),
            source_slug: target.getAttribute("data-source-slug"),
            slot_index: target.getAttribute("data-slot-index"),
            recommendation_role: target.getAttribute("data-recommendation-role"),
            item_id: target.getAttribute("data-item-id"),
            link_url: target.getAttribute("href"),
            link_text: target.textContent?.trim()
          });
        });
      }
    </script>
    <footer class="site-footer">
      <div class="container footer-content">
        <div class="footer-about">
          <h2>{affiliate.siteName}</h2>
          <p>保健室だよりのように、エアコンの不調を安全確認、修理相談、買い替え検討の順番で整理する相談ノートです。</p>
        </div>
        <nav class="footer-sitemap" aria-label="フッターサイトマップ">
          {footerSiteMap.map((group) => (
            <section class="footer-links" aria-labelledby={`footer-${group.id}`}>
              <h3 id={`footer-${group.id}`}>{group.heading}</h3>
              <ul>
                {group.links.map((link) => (
                  <li><a href={sitePath(link.href)}>{link.label}</a></li>
                ))}
              </ul>
            </section>
          ))}
        </nav>
      </div>
    </footer>
    {showChatFloat && <ChatFloat />}
  </body>
</html>
