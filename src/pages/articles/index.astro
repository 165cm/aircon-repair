---
import { getCollection } from "astro:content";
import ArticleCard from "@components/ArticleCard.astro";
import RevenueCta from "@components/RevenueCta.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getCanonicalArticles } from "@data/internalLinks";
import { sitePath } from "@utils/paths";

const articles = getCanonicalArticles(await getCollection("articles")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout
  title="記事一覧"
  description="エアコンの症状別トラブル、基礎知識、掃除予防、求人入門の記事一覧です。"
>
  <section class="container section">
    <p class="eyebrow">記事一覧</p>
    <h1>エアコンの困りごとガイド</h1>
    <p class="lead">症状別、掃除・予防、買い替え、求人・仕事入門までまとめています。</p>
    <div class="hero-actions">
      <a class="button" href={sitePath("/diagnosis/")}>症状診断</a>
      <a class="button warm" href={sitePath("/by-size/")}>畳数で買い替え比較</a>
      <a class="button secondary" href={sitePath("/products/")}>商品比較</a>
    </div>
  </section>
  <section class="container section">
    <div class="grid">
      {articles.map((article) => <ArticleCard article={article} />)}
    </div>
  </section>
  <section class="container section">
    <div class="grid two">
      <RevenueCta variant="products" />
      <RevenueCta variant="jobs" />
    </div>
  </section>
</BaseLayout>
