---
import { getCollection, render } from "astro:content";
import GlossaryBox from "@components/GlossaryBox.astro";
import EmergencyAlert from "@components/EmergencyAlert.astro";
import KazamiSpeech from "@components/KazamiSpeech.astro";
import NextActionCard from "@components/NextActionCard.astro";
import RevenueCta from "@components/RevenueCta.astro";
import CleaningServicePicker from "@components/CleaningServicePicker.astro";
import AmazonLink from "@components/AmazonLink.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { affiliate } from "@data/affiliate";
import { getArticleRecommendations, getCanonicalArticles, getProductRecommendations } from "@data/internalLinks";
import { healthRoomTeacher } from "@data/teachers";
import { articleThumbnail } from "@utils/articles";
import { absoluteUrl, sitePath } from "@utils/paths";

export async function getStaticPaths() {
  const articles = getCanonicalArticles(await getCollection("articles"));
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article }
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const allArticles = getCanonicalArticles(await getCollection("articles"));
const relatedProductRecommendations = getProductRecommendations(article.slug, article);
const relatedProducts = relatedProductRecommendations.map((recommendation) => recommendation.product);
const canonical = absoluteUrl(`/articles/${article.slug}/`);
const breadcrumbs = [
  { label: "ホーム", href: "/" },
  { label: "記事一覧", href: "/articles/" },
  { label: article.data.title }
];
const ctaVariant = article.data.recommendedCta === "jobs"
  ? "jobs"
  : article.data.recommendedCta === "products"
    ? "products"
    : article.data.recommendedCta === "cleaning"
      ? "cleaning"
      : "contractor";
const isCleaningGuide = article.slug === "aircon-cleaning-company-guide";
const showCleaningPicker = isCleaningGuide || article.slug === "aircon-not-cooling-fan-dirt";
const teacher = healthRoomTeacher;
const nextLessons = getArticleRecommendations(article.slug, article, allArticles);
const showReplacementGuide = article.data.category === "symptom" || article.data.category === "energy-saving";
const categoryLabel = {
  symptom: "症状別",
  basics: "基礎知識",
  cleaning: "掃除・予防",
  career: "求人・仕事",
  buying: "買い替え",
  "energy-saving": "節電"
}[article.data.category];
const riskLabel = {
  low: "低め",
  medium: "注意",
  high: "危険サインあり"
}[article.data.risk];
const hasQuickAnswer = article.data.quickAnswer.length > 0;
const hasBoardImage = Boolean(article.data.boardImage);
// 図解の下に出る風見先生の一言。困って検索してきた読者に最初にかける言葉なので、
// frontmatter の kazamiIntro に記事ごとの状況へ寄せた文を書く。
// 下のカテゴリ別の文は、書き忘れたときに文章が消えないための保険。
const kazamiIntro = article.data.kazamiIntro ?? (
  article.data.risk === "high"
    ? "あぶないサインが出ているなら、まず運転を止めましょう。原因さがしは、そのあとで大丈夫です。"
    : {
        buying: "あわてて決めなくて大丈夫です。部屋の広さと、本体・工事を合わせた総額から見ていきましょう。",
        cleaning: "掃除は、手が届く範囲だけで十分です。奥のほうは、私たちの仕事にしてください。",
        career: "現場の話をしますね。どんな仕事か、まずはざっと見てみましょう。",
        basics: "むずかしい理屈は置いておいて、まず使うときに困らないところから見ていきましょう。",
        "energy-saving": "電気代は、使い方と汚れで変わります。今日からできるところだけ拾っていきましょう。",
        symptom: "この症状だけで、故障とは決まりません。外から見える範囲から、順番にいきましょう。"
      }[article.data.category]
);
const safeCheckNotes = article.data.category === "buying"
  ? ["部屋の畳数、置き場所、コンセントの形をメモする。", "修理の見積もりと、本体＋工事費を並べて比べる。", "急がず、標準工事に入らない費用まで聞いておく。"]
  : ["外から見える範囲だけ確認する。", "型番、買った年、症状、いつからかをメモする。", "暑いとき・水が出ているときは、先に人と床を守る。"];
// 「触ってはいけない場所」を並べても、読者はもともと触らない。
// それより「直らないなら、なぜ人に頼むのか・どこに頼むのか」を出す。
const nextStepNotes = article.data.category === "cleaning"
  ? [
      "内部の洗浄は、分解して電装部品を養生しないとできません。",
      "市販スプレーを奥まで吹くと、かえって故障の原因になります。",
      "カビ臭が残るときは、内部清掃を頼むほうが結果的に安く済みます。"
    ]
  : [
      "冷媒や配管は、圧力の測定とフロン類の資格がいる作業です。",
      "基板や電源まわりは、通電したままの測定と部品交換が必要です。",
      "賃貸なら管理会社か大家さんへ、持ち家ならメーカー窓口へ連絡します。"
    ];
// Discover露出の前提となる記事画像（横長サムネ/図解）。新画像を入れたらboardImage経由で自動反映される。
const articleImageUrl = absoluteUrl(articleThumbnail(article));

// 全記事同一の定型FAQをやめ、その記事固有のquickAnswerから先頭の質問を組み立てる。
const faqEntities: Record<string, unknown>[] = [];
if (hasQuickAnswer) {
  faqEntities.push({
    "@type": "Question",
    name: `${article.data.title}で、まず確認することは？`,
    acceptedAnswer: {
      "@type": "Answer",
      text: article.data.quickAnswer.join(" ")
    }
  });
}
faqEntities.push(
  {
    "@type": "Question",
    name: "初心者が自分で修理してもよいですか？",
    acceptedAnswer: {
      "@type": "Answer",
      text: "当サイトでは分解修理、電気配線、冷媒、内部洗浄を初心者へ推奨しません。安全にできる確認に留め、危険サインがある場合は専門業者へ相談してください。"
    }
  },
  {
    "@type": "Question",
    name: "商品リンクには広告が含まれますか？",
    acceptedAnswer: {
      "@type": "Answer",
      text: "はい。Amazonアソシエイトを含む広告・アフィリエイトリンクが含まれる場合があります。"
    }
  }
);

const jsonLd: Record<string, unknown>[] = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: article.data.title,
    description: article.data.description,
    image: [articleImageUrl],
    datePublished: article.data.pubDate.toISOString(),
    dateModified: (article.data.updatedDate ?? article.data.pubDate).toISOString(),
    author: {
      "@type": "Organization",
      name: affiliate.siteName
    },
    publisher: {
      "@type": "Organization",
      name: affiliate.siteName,
      logo: {
        "@type": "ImageObject",
        url: absoluteUrl("/favicon-kazami-v1.png")
      }
    },
    mentions: relatedProducts.map((product) => ({
      "@type": "Thing",
      name: product.name,
      url: absoluteUrl(`/products/${product.id}/`)
    })),
    mainEntityOfPage: canonical
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqEntities
  }
];

// 症状・掃除・節電の手順性のある記事は、quickAnswerを安全チェック手順としてHowToでも記述する。
const isProceduralArticle =
  ["symptom", "cleaning", "energy-saving"].includes(article.data.category) &&
  article.data.quickAnswer.length >= 2;
if (isProceduralArticle) {
  jsonLd.push({
    "@context": "https://schema.org",
    "@type": "HowTo",
    name: `${article.data.title}の安全チェック手順`,
    description: article.data.description,
    image: [articleImageUrl],
    step: article.data.quickAnswer.map((text, index) => ({
      "@type": "HowToStep",
      position: index + 1,
      name: `手順${index + 1}`,
      text
    }))
  });
}
---

<BaseLayout title={article.data.title} description={article.data.description} canonical={canonical} jsonLd={jsonLd} ogImage={articleThumbnail(article)} breadcrumbs={breadcrumbs}>
  <section class="container article-head">
    <p class="eyebrow">{categoryLabel}</p>
    <h1>{article.data.title}</h1>
    <p class="article-meta">
      <span class:list={["article-risk", `article-risk-${article.data.risk}`]}>危険度: {riskLabel}</span>
      <span>
        {article.data.updatedDate
          ? `更新 ${article.data.updatedDate.toLocaleDateString("ja-JP", { year: "numeric", month: "numeric", day: "numeric" })}`
          : `公開 ${article.data.pubDate.toLocaleDateString("ja-JP", { year: "numeric", month: "numeric", day: "numeric" })}`}
      </span>
    </p>
  </section>
  <section class="container article-body">
    <article class="article-content">
      <div id="article-main"></div>
      {
        hasQuickAnswer && (
          <section class="lesson-summary" aria-labelledby="quick-answer-title">
            <h2 id="quick-answer-title">先に結論</h2>
            <ul>
              {article.data.quickAnswer.map((answer) => (
                <li>{answer}</li>
              ))}
            </ul>
          </section>
        )
      }
      {/* 検索から来た読者は説明文をスニペットで読んでいるので、結論より下に置く */}
      <p class="article-summary">{article.data.description}</p>
      <EmergencyAlert compact />
      {
        hasBoardImage && (
          <figure class="board-figure board-figure-intro">
            <img src={sitePath(article.data.boardImage)} alt={article.data.boardAlt ?? `${article.data.title}の図解`} loading="lazy" />
          </figure>
        )
      }
      <KazamiSpeech tone={article.data.risk === "high" ? "warning" : "normal"}>
        {kazamiIntro}
      </KazamiSpeech>
      {isCleaningGuide && <CleaningServicePicker sourceSlug={article.slug} showPending />}
      <Content />
      {showCleaningPicker && !isCleaningGuide && <CleaningServicePicker sourceSlug={article.slug} />}
      <section class="care-sheet" aria-label="自分で見ていい範囲と、直らないときの連絡先">
        <div>
          <h2>ここまでは見てOK</h2>
          <ul>{safeCheckNotes.map((note) => <li>{note}</li>)}</ul>
        </div>
        <div class="next-note">
          <h2>直らないときは</h2>
          <ul>{nextStepNotes.map((note) => <li>{note}</li>)}</ul>
          <a
            class="inline-link"
            href={sitePath("/maker-contacts/")}
            data-cvr-action="article_care_sheet_maker_click"
            data-action-kind="contractor"
            data-source-slug={article.slug}
          >
            メーカーの問い合わせ先を見る
          </a>
        </div>
      </section>
      {
        relatedProducts.length > 0 && (
          <aside class="mini-product-cta" aria-labelledby="mini-product-title">
            <div>
              <h2 id="mini-product-title">確認に使える道具</h2>
              <div class="mini-product-list">
                {relatedProducts.map((product, index) => {
                  const recommendation = relatedProductRecommendations[index];
                  return (
                    <article class="mini-product-card">
                      {product.image && (
                        <img
                          class="mini-product-image"
                          src={sitePath(product.image)}
                          alt={`${product.name}を使う場面のイメージイラスト`}
                          loading="lazy"
                        />
                      )}
                      <div class="mini-product-copy">
                        <strong>{product.name}</strong>
                        <span>{product.description}</span>
                        <small>{product.safetyNote}</small>
                      </div>
                      <div class="mini-product-actions">
                        <a
                          class="inline-link"
                          href={sitePath(`/products/${product.id}/`)}
                          data-cvr-action="article_intro_product_detail_click"
                          data-action-kind={product.type === "replacement" ? "replacement" : "products"}
                          data-source-slug={article.slug}
                          data-slot-index={index + 1}
                          data-recommendation-role={recommendation?.role}
                          data-item-id={product.id}
                        >
                          選び方を見る
                        </a>
                        <AmazonLink
                          product={product}
                          label="Amazonで確認"
                          pageType="article"
                          linkPosition="article-product-illustration"
                          sourceSlug={article.slug}
                          slotIndex={index + 1}
                          recommendationRole={recommendation?.role}
                        />
                      </div>
                    </article>
                  );
                })}
              </div>
            </div>
            <a
              class="button secondary"
              href={sitePath("/products/")}
              data-cvr-action="article_intro_product_list_click"
              data-action-kind="products"
              data-source-slug={article.slug}
              data-slot-index="0"
              data-recommendation-role="product-list"
              data-item-id="products"
            >
              商品カテゴリを見る
            </a>
          </aside>
        )
      }
      <div id="next-action"><NextActionCard sourceSlug={article.slug} /></div>
      {
        showReplacementGuide && (
          <aside class="replacement-check" aria-labelledby="replacement-check-title">
            <div class="replacement-check-head">
              <h2 id="replacement-check-title">修理より買い替えが早いかも</h2>
              <p>10年以上・修理費が高い・部屋に合わない。ひとつでも当てはまるなら、修理を待つあいだに本体も見ておくと落ち着いて選べます。</p>
            </div>
            <div class="replacement-check-grid">
              <span>📅 10年以上</span>
              <span>💴 修理費が高い</span>
              <span>📐 部屋に合わない</span>
            </div>
            <div class="replacement-check-actions">
              <a
                class="button warm"
                href={sitePath("/by-size/")}
                data-cvr-action="article_replacement_guide_by_size_click"
                data-action-kind="replacement"
                data-source-slug={article.slug}
                data-slot-index="0"
                data-recommendation-role="replacement"
                data-item-id="by-size"
              >
                畳数から買い替え候補を見る
              </a>
              <a
                class="inline-link"
                href={sitePath("/articles/installation-cost/")}
                data-cvr-action="article_replacement_cost_click"
                data-action-kind="replacement"
                data-source-slug={article.slug}
                data-slot-index="1"
                data-recommendation-role="replacement"
                data-item-id="installation-cost"
              >
                工事費のめやすも見る
              </a>
            </div>
          </aside>
        )
      }
      {
        nextLessons.length > 0 && (
          <section class="next-lessons" aria-labelledby="next-lessons-title">
            <h2 id="next-lessons-title">関連記事</h2>
            <div class="next-lesson-grid">
              {nextLessons.map((recommendation, index) => (
                <a
                  href={sitePath(`/articles/${recommendation.article.slug}/`)}
                  aria-label={`${recommendation.article.data.title}: ${recommendation.article.data.description}`}
                  data-cvr-action="article_related_article_click"
                  data-action-kind="safe"
                  data-source-slug={article.slug}
                  data-slot-index={index + 1}
                  data-recommendation-role={recommendation.role}
                  data-item-id={recommendation.article.slug}
                >
                  <img src={sitePath(articleThumbnail(recommendation.article))} alt="" loading="lazy" />
                  <strong>{recommendation.article.data.title}</strong>
                </a>
              ))}
            </div>
          </section>
        )
      }
      <section class="teacher-panel" aria-labelledby="teacher-title">
        <img class="teacher-portrait" src={sitePath(teacher.image)} alt={`${teacher.name}先生の顔`} loading="lazy" />
        <div class="teacher-copy">
          <div class="teacher-heading">
            <h2 id="teacher-title">{teacher.name}先生</h2>
            <p class="teacher-subject">{teacher.subject}</p>
          </div>
          <p class="teacher-profile-summary">{teacher.profile}</p>
          <details class="teacher-details">
            <summary>風見先生について</summary>
            <div class="teacher-details-body">
              {teacher.detailProfile.map((detail) => <p>{detail}</p>)}
            </div>
          </details>
        </div>
      </section>
    </article>
    <details class="article-sidebar-toggle">
      <summary aria-label="補助情報を開閉" title="補助情報">
        <span class="sidebar-toggle-icon" aria-hidden="true"></span>
      </summary>
      <aside class="sidebar" aria-label="記事の補助情報">
        <GlossaryBox title="この記事のミニ用語集" limit={4} />
        <RevenueCta variant={ctaVariant} />
      </aside>
    </details>
  </section>
</BaseLayout>
