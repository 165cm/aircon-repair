---
import { getCollection, render } from "astro:content";
import ActionPanel, { type ActionItem } from "@components/ActionPanel.astro";
import GlossaryBox from "@components/GlossaryBox.astro";
import ProductGrid from "@components/ProductGrid.astro";
import RevenueCta from "@components/RevenueCta.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { affiliate } from "@data/affiliate";
import { diagnosisItems } from "@data/diagnosis";
import { productsByIds, productsForSymptom, replacementProducts } from "@data/products";
import { absoluteUrl } from "@utils/paths";

export async function getStaticPaths() {
  const articles = await getCollection("articles");
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article }
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const frontmatterProducts = productsByIds(article.data.products);
const symptomProducts = article.data.symptoms.flatMap(productsForSymptom);
const products = [
  ...new Map([...frontmatterProducts, ...symptomProducts].map((product) => [product.id, product])).values()
];
const sidebarProducts = frontmatterProducts.length > 0 ? frontmatterProducts.slice(0, 2) : products.slice(0, 2);
const relatedProducts = frontmatterProducts.length > 0 ? frontmatterProducts : products.slice(0, 8);
const canonical = absoluteUrl(`/articles/${article.slug}/`);
const breadcrumbs = [
  { label: "ホーム", href: "/" },
  { label: "記事一覧", href: "/articles/" },
  { label: article.data.title }
];
const ctaVariant = article.data.recommendedCta === "jobs" ? "jobs" : article.data.recommendedCta === "products" ? "products" : "contractor";
const showReplacement = article.data.symptoms.includes("冷えない") || article.data.symptoms.includes("修理");
const matchedDiagnosis = diagnosisItems.find((item) => item.articleSlugs.includes(article.slug)) ?? diagnosisItems[0];
const articleActions = [
  {
    kind: "safe",
    label: "症状診断で確認する",
    href: `/diagnosis/#${matchedDiagnosis.id}`,
    body: "危険サインと安全に見てよい場所を先に整理",
    action: "article_diagnosis_click",
    primary: article.data.recommendedCta === "learn"
  },
  {
    kind: "products",
    label: "補助用品を比較する",
    href: relatedProducts.length > 0 ? "#mentioned-products" : "/products/",
    body: "分解しない範囲で使える候補だけを見る",
    action: "article_products_click",
    primary: ctaVariant === "products"
  },
  {
    kind: "replacement",
    label: "買い替えも比較する",
    href: showReplacement ? "#replacement" : "/by-size/",
    body: "10年以上・高額修理なら畳数と工事条件を確認",
    action: "article_replacement_click",
    primary: showReplacement
  },
  {
    kind: "contractor",
    label: "業者相談の候補を見る",
    href: affiliate.contractorAffiliateUrl,
    body: "焦げ臭い・水が電源近く・金属音は無理しない",
    action: "article_contractor_click",
    external: true,
    primary: ctaVariant === "contractor"
  }
] satisfies ActionItem[];
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: article.data.title,
    description: article.data.description,
    datePublished: article.data.pubDate.toISOString(),
    author: {
      "@type": "Organization",
      name: affiliate.siteName
    },
    publisher: {
      "@type": "Organization",
      name: affiliate.siteName
    },
    mentions: relatedProducts.map((product) => ({
      "@type": "Product",
      name: product.name,
      brand: product.brand,
      category: product.category,
      url: absoluteUrl(`/products/${product.id}/`)
    })),
    mainEntityOfPage: canonical
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: [
      {
        "@type": "Question",
        name: "初心者が自分で修理してもよいですか？",
        acceptedAnswer: {
          "@type": "Answer",
          text: "当サイトでは分解修理、電気配線、冷媒、内部洗浄を初心者へ推奨しません。安全にできる確認に留め、危険サインがある場合は専門業者へ相談してください。"
        }
      },
      {
        "@type": "Question",
        name: "商品リンクには広告が含まれますか？",
        acceptedAnswer: {
          "@type": "Answer",
          text: "はい。Amazonアソシエイトを含む広告・アフィリエイトリンクが含まれる場合があります。"
        }
      }
    ]
  }
];
---

<BaseLayout title={article.data.title} description={article.data.description} canonical={canonical} jsonLd={jsonLd} breadcrumbs={breadcrumbs}>
  <section class="container section">
    <p class="eyebrow">{article.data.category}</p>
    <h1>{article.data.title}</h1>
    <p class="lead">{article.data.description}</p>
    <div class="tag-list">
      <span class="tag">危険度: {article.data.risk}</span>
      <span class="tag">{article.data.difficulty === "beginner" ? "初心者向け" : "一歩詳しく"}</span>
      {article.data.symptoms.map((symptom) => <span class="tag">{symptom}</span>)}
    </div>
  </section>
  <section class="container article-body">
    <article class="article-content">
      <div class="notice safe">
        <strong>この授業の読み方:</strong> 難しい専門用語は下のミニ解説で確認できます。自力でできるのはフィルター、リモコン、室外機まわり、ドレンホース先端などの外側確認までです。
      </div>
      <ActionPanel
        eyebrow="この記事を読んだら"
        title="迷ったら、危険サイン・補助用品・買い替えをここから選ぶ"
        description="症状に合わせて、読者が次に取りやすい行動だけを並べています。"
        items={articleActions}
        image={showReplacement ? "/images/repair-or-replace.webp" : "/images/safe-check-flow.webp"}
        imageAlt={showReplacement ? "修理費と買い替えを比較する机上のイメージ" : "安全なエアコン確認のイメージ"}
        compact
      />
      <Content />
      <ActionPanel
        eyebrow="次の一手"
        title="この記事だけで判断しきれない時の行動"
        items={articleActions}
        compact
      />
    </article>
    <aside class="sidebar">
      <GlossaryBox title="この記事で出やすい用語" limit={4} />
      <RevenueCta variant={ctaVariant} />
      {sidebarProducts.length > 0 && <ProductGrid products={sidebarProducts} pageType={`article-${article.slug}`} linkPosition="sidebar" />}
    </aside>
  </section>
  {
    relatedProducts.length > 0 && (
      <section class="container section" id="mentioned-products">
        <div class="section-header">
          <div>
            <p class="eyebrow">この記事で紹介した商品</p>
            <h2>症状に合わせて比較したい候補</h2>
            <p>記事内容に合わせて手動で紐付けた商品です。掲載画像は当サイト生成のイメージで、実際の写真・仕様・価格はリンク先で確認してください。</p>
          </div>
        </div>
        <ProductGrid products={relatedProducts} pageType={`article-${article.slug}`} linkPosition="mentioned-products" />
      </section>
    )
  }
  {
    showReplacement && (
      <section class="container section" id="replacement">
        <div class="section-header">
          <div>
            <p class="eyebrow">買い替え比較</p>
            <h2>修理費が高い時のエアコン本体候補</h2>
            <p>掲載画像は当サイト生成のイメージです。実際の商品写真・仕様・標準工事・追加工事費はリンク先で確認してください。</p>
          </div>
        </div>
        <ProductGrid products={replacementProducts} pageType={`article-${article.slug}`} linkPosition="replacement-section" />
      </section>
    )
  }
</BaseLayout>
