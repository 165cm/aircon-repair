---
import { getCollection, render } from "astro:content";
import GlossaryBox from "@components/GlossaryBox.astro";
import ProductGrid from "@components/ProductGrid.astro";
import RevenueCta from "@components/RevenueCta.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { affiliate } from "@data/affiliate";
import { productsByIds, productsForSymptom, replacementProducts } from "@data/products";
import { absoluteUrl } from "@utils/paths";

export async function getStaticPaths() {
  const articles = await getCollection("articles");
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article }
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const frontmatterProducts = productsByIds(article.data.products);
const symptomProducts = article.data.symptoms.flatMap(productsForSymptom);
const products = [
  ...new Map([...frontmatterProducts, ...symptomProducts].map((product) => [product.id, product])).values()
];
const sidebarProducts = frontmatterProducts.length > 0 ? frontmatterProducts.slice(0, 2) : products.slice(0, 2);
const relatedProducts = frontmatterProducts.length > 0 ? frontmatterProducts : products.slice(0, 8);
const canonical = absoluteUrl(`/articles/${article.slug}/`);
const ctaVariant = article.data.recommendedCta === "jobs" ? "jobs" : article.data.recommendedCta === "products" ? "products" : "contractor";
const showReplacement = article.data.symptoms.includes("冷えない") || article.data.symptoms.includes("修理");
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: article.data.title,
    description: article.data.description,
    datePublished: article.data.pubDate.toISOString(),
    author: {
      "@type": "Organization",
      name: affiliate.siteName
    },
    publisher: {
      "@type": "Organization",
      name: affiliate.siteName
    },
    mentions: relatedProducts.map((product) => ({
      "@type": "Product",
      name: product.name,
      brand: product.brand,
      category: product.category,
      url: absoluteUrl(`/products/${product.id}/`)
    })),
    mainEntityOfPage: canonical
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: [
      {
        "@type": "Question",
        name: "初心者が自分で修理してもよいですか？",
        acceptedAnswer: {
          "@type": "Answer",
          text: "当サイトでは分解修理、電気配線、冷媒、内部洗浄を初心者へ推奨しません。安全にできる確認に留め、危険サインがある場合は専門業者へ相談してください。"
        }
      },
      {
        "@type": "Question",
        name: "商品リンクには広告が含まれますか？",
        acceptedAnswer: {
          "@type": "Answer",
          text: "はい。Amazonアソシエイトを含む広告・アフィリエイトリンクが含まれる場合があります。"
        }
      }
    ]
  }
];
---

<BaseLayout title={article.data.title} description={article.data.description} canonical={canonical} jsonLd={jsonLd}>
  <section class="container section">
    <p class="eyebrow">{article.data.category}</p>
    <h1>{article.data.title}</h1>
    <p class="lead">{article.data.description}</p>
    <div class="tag-list">
      <span class="tag">危険度: {article.data.risk}</span>
      <span class="tag">{article.data.difficulty === "beginner" ? "初心者向け" : "一歩詳しく"}</span>
      {article.data.symptoms.map((symptom) => <span class="tag">{symptom}</span>)}
    </div>
  </section>
  <section class="container article-body">
    <article class="article-content">
      <div class="notice safe">
        <strong>この授業の読み方:</strong> 難しい専門用語は下のミニ解説で確認できます。自力でできるのはフィルター、リモコン、室外機まわり、ドレンホース先端などの外側確認までです。
      </div>
      <Content />
    </article>
    <aside class="sidebar">
      <GlossaryBox title="この記事で出やすい用語" limit={4} />
      <RevenueCta variant={ctaVariant} />
      {sidebarProducts.length > 0 && <ProductGrid products={sidebarProducts} pageType={`article-${article.slug}`} linkPosition="sidebar" />}
    </aside>
  </section>
  {
    relatedProducts.length > 0 && (
      <section class="container section" id="mentioned-products">
        <div class="section-header">
          <div>
            <p class="eyebrow">この記事で紹介した商品</p>
            <h2>症状に合わせて比較したい候補</h2>
            <p>記事内容に合わせて手動で紐付けた商品です。掲載画像は当サイト生成のイメージで、実際の写真・仕様・価格はリンク先で確認してください。</p>
          </div>
        </div>
        <ProductGrid products={relatedProducts} pageType={`article-${article.slug}`} linkPosition="mentioned-products" />
      </section>
    )
  }
  {
    showReplacement && (
      <section class="container section" id="replacement">
        <div class="section-header">
          <div>
            <p class="eyebrow">買い替え比較</p>
            <h2>修理費が高い時のエアコン本体候補</h2>
            <p>掲載画像は当サイト生成のイメージです。実際の商品写真・仕様・標準工事・追加工事費はリンク先で確認してください。</p>
          </div>
        </div>
        <ProductGrid products={replacementProducts} pageType={`article-${article.slug}`} linkPosition="replacement-section" />
      </section>
    )
  }
</BaseLayout>
