---
import { getCollection, render } from "astro:content";
import GlossaryBox from "@components/GlossaryBox.astro";
import ProductCard from "@components/ProductCard.astro";
import RevenueCta from "@components/RevenueCta.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { affiliate } from "@data/affiliate";
import { getArticleRecommendations, getCanonicalArticles, getProductRecommendations } from "@data/internalLinks";
import { healthRoomTeacher } from "@data/teachers";
import { absoluteUrl, sitePath } from "@utils/paths";

export async function getStaticPaths() {
  const articles = getCanonicalArticles(await getCollection("articles"));
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article }
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const allArticles = getCanonicalArticles(await getCollection("articles"));
const relatedProductRecommendations = getProductRecommendations(article.slug, article);
const relatedProducts = relatedProductRecommendations.map((recommendation) => recommendation.product);
const canonical = absoluteUrl(`/articles/${article.slug}/`);
const breadcrumbs = [
  { label: "ホーム", href: "/" },
  { label: "記事一覧", href: "/articles/" },
  { label: article.data.title }
];
const ctaVariant = article.data.recommendedCta === "jobs" ? "jobs" : article.data.recommendedCta === "products" ? "products" : "contractor";
const showReplacement = article.data.symptoms.includes("冷えない") || article.data.symptoms.includes("修理");
const teacher = healthRoomTeacher;
const nextLessons = getArticleRecommendations(article.slug, article, allArticles);
const articleThumbnail = (entry: (typeof allArticles)[number]) => {
  if (entry.data.boardImage) {
    return entry.data.boardImage;
  }

  return entry.body.match(/!\[[^\]]*\]\(([^)]+)\)/)?.[1] ?? "/images/articles/basics-safe-check-zones.webp";
};
const showReplacementGuide = article.data.category === "symptom" || article.data.category === "energy-saving";
const categoryLabel = {
  symptom: "症状別",
  basics: "基礎知識",
  cleaning: "掃除・予防",
  career: "求人・仕事",
  buying: "買い替え",
  "energy-saving": "節電"
}[article.data.category];
const riskLabel = {
  low: "低め",
  medium: "注意",
  high: "危険サインあり"
}[article.data.risk];
const safeCheckNotes = article.data.category === "buying"
  ? ["部屋の畳数、設置場所、コンセント形状をメモする。", "修理見積もりと新品本体、工事費を同じ紙で比べる。", "急いで買わず、標準工事に含まれない費用を確認する。"]
  : ["外側から見える範囲だけ確認する。", "型番、購入年、症状、発生した時間をメモする。", "暑さや水濡れがある時は、先に人と床を守る。"];
const doNotTouchNotes = article.data.category === "cleaning"
  ? ["内部ファン、熱交換器、電装部品へスプレーしない。", "分解洗浄や高所作業は自分で進めない。", "カビ臭が残る時は、内部清掃の相談へ切り替える。"]
  : ["冷媒配管、基板、電源配線、室外機の中は触らない。", "焦げ臭い、煙、火花、金属音、水が電源付近にある時は使用停止。", "原因が分からないまま運転を続けない。"];
const consultNotes = showReplacementGuide
  ? ["危険サインがあれば修理相談を優先する。", "10年以上・複数症状・高額見積もりなら買い替えも同時に比べる。", "判断に迷う時は、診断チャットで症状を選び直す。"]
  : ["外側確認で改善しなければ、無理せず相談へ進む。", "必要なら関連記事で基礎を確認する。", "判断に迷う時は、診断チャットで症状を選び直す。"];
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: article.data.title,
    description: article.data.description,
    datePublished: article.data.pubDate.toISOString(),
    author: {
      "@type": "Organization",
      name: affiliate.siteName
    },
    publisher: {
      "@type": "Organization",
      name: affiliate.siteName
    },
    mentions: relatedProducts.map((product) => ({
      "@type": "Product",
      name: product.name,
      brand: product.brand,
      category: product.category,
      url: absoluteUrl(`/products/${product.id}/`)
    })),
    mainEntityOfPage: canonical
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: [
      {
        "@type": "Question",
        name: "初心者が自分で修理してもよいですか？",
        acceptedAnswer: {
          "@type": "Answer",
          text: "当サイトでは分解修理、電気配線、冷媒、内部洗浄を初心者へ推奨しません。安全にできる確認に留め、危険サインがある場合は専門業者へ相談してください。"
        }
      },
      {
        "@type": "Question",
        name: "商品リンクには広告が含まれますか？",
        acceptedAnswer: {
          "@type": "Answer",
          text: "はい。Amazonアソシエイトを含む広告・アフィリエイトリンクが含まれる場合があります。"
        }
      }
    ]
  }
];
---

<BaseLayout title={article.data.title} description={article.data.description} canonical={canonical} jsonLd={jsonLd} breadcrumbs={breadcrumbs}>
  <section class="container section">
    <p class="eyebrow">{categoryLabel}</p>
    <h1>{article.data.title}</h1>
    <p class="lead">{article.data.description}</p>
    <div class="tag-list">
      <span class="tag">危険度: {riskLabel}</span>
      <span class="tag">{article.data.difficulty === "beginner" ? "初心者向け" : "一歩詳しく"}</span>
      {article.data.symptoms.map((symptom) => <span class="tag">{symptom}</span>)}
    </div>
  </section>
  <section class="container article-body">
    <article class="article-content">
      {
        article.data.quickAnswer.length > 0 && (
          <section class="lesson-summary" aria-labelledby="quick-answer-title">
            <h2 id="quick-answer-title">今日の結論</h2>
            <ul>
              {article.data.quickAnswer.map((answer) => (
                <li>{answer}</li>
              ))}
            </ul>
          </section>
        )
      }
      <Content />
      <section class="care-sheet" aria-label="安全確認と次の相談">
        <div>
          <h2>安全に確認</h2>
          <ul>{safeCheckNotes.map((note) => <li>{note}</li>)}</ul>
        </div>
        <div class="danger-note">
          <h2>触らない場所</h2>
          <ul>{doNotTouchNotes.map((note) => <li>{note}</li>)}</ul>
        </div>
        <div>
          <h2>次に相談する</h2>
          <ul>{consultNotes.map((note) => <li>{note}</li>)}</ul>
        </div>
      </section>
      {
        article.data.boardImage && (
          <figure class="board-figure">
            <img src={sitePath(article.data.boardImage)} alt={article.data.boardAlt ?? `${article.data.title}の図解`} loading="lazy" />
            <figcaption>{article.data.boardAlt ?? "この記事の要点を図解で整理しています。"}</figcaption>
          </figure>
        )
      }
      {
        relatedProducts.length > 0 && (
          <aside class="mini-product-cta" aria-labelledby="mini-product-title">
            <div>
              <h2 id="mini-product-title">次の処置に使う候補</h2>
              <div class="mini-product-list">
                {relatedProducts.map((product) => (
                  <a
                    class="mini-product-card"
                    href={sitePath(`/products/${product.id}/`)}
                    data-cvr-action="article_intro_product_detail_click"
                    data-action-kind={product.type === "replacement" ? "replacement" : "products"}
                    data-source-slug={article.slug}
                    data-slot-index={relatedProducts.findIndex((candidate) => candidate.id === product.id) + 1}
                    data-recommendation-role={relatedProductRecommendations.find((recommendation) => recommendation.product.id === product.id)?.role}
                    data-item-id={product.id}
                  >
                    <strong>{product.name}</strong>
                    <span>{product.description}</span>
                    <small>{product.safetyNote}</small>
                  </a>
                ))}
              </div>
            </div>
            <a
              class="button secondary"
              href={sitePath("/products/")}
              data-cvr-action="article_intro_product_list_click"
              data-action-kind="products"
              data-source-slug={article.slug}
              data-slot-index="0"
              data-recommendation-role="product-list"
              data-item-id="products"
            >
              商品カテゴリを見る
            </a>
          </aside>
        )
      }
      {
        showReplacementGuide && (
          <aside class="replacement-check" aria-labelledby="replacement-check-title">
            <div class="replacement-check-head">
              <h2 id="replacement-check-title">修理より買い替えが早いかも</h2>
              <p>10年以上・修理費高め・部屋に合わない。ひとつでも当てはまるなら、修理待ちの間に本体候補も見ておくと安心です。</p>
            </div>
            <div class="replacement-check-grid">
              <span>📅 10年以上</span>
              <span>💴 修理費が高い</span>
              <span>📐 部屋に合わない</span>
            </div>
            <div class="replacement-check-actions">
              <a
                class="button warm"
                href={sitePath("/by-size/")}
                data-cvr-action="article_replacement_guide_by_size_click"
                data-action-kind="replacement"
                data-source-slug={article.slug}
                data-slot-index="0"
                data-recommendation-role="replacement"
                data-item-id="by-size"
              >
                畳数から買い替え候補を見る
              </a>
            </div>
          </aside>
        )
      }
      {
        nextLessons.length > 0 && (
          <section class="next-lessons" aria-labelledby="next-lessons-title">
            <h2 id="next-lessons-title">関連記事</h2>
            <div class="next-lesson-grid">
              {nextLessons.map((recommendation, index) => (
                <a
                  href={sitePath(`/articles/${recommendation.article.slug}/`)}
                  aria-label={`${recommendation.article.data.title}: ${recommendation.article.data.description}`}
                  data-cvr-action="article_related_article_click"
                  data-action-kind="safe"
                  data-source-slug={article.slug}
                  data-slot-index={index + 1}
                  data-recommendation-role={recommendation.role}
                  data-item-id={recommendation.article.slug}
                >
                  <img src={sitePath(articleThumbnail(recommendation.article))} alt="" loading="lazy" />
                  <strong>{recommendation.article.data.title}</strong>
                </a>
              ))}
            </div>
          </section>
        )
      }
      <section class="teacher-panel" aria-labelledby="teacher-title">
        <img class="teacher-portrait" src={sitePath(teacher.image)} alt={`${teacher.name}先生の顔`} loading="lazy" />
        <div class="teacher-copy">
          <div class="teacher-heading">
            <h2 id="teacher-title">{teacher.name}先生</h2>
            <p class="teacher-subject">{teacher.subject}</p>
          </div>
          <blockquote>{teacher.catchphrase}</blockquote>
          <p class="teacher-profile-summary">{teacher.profile}</p>
          <details class="teacher-details">
            <summary>すずね先生の自己紹介を読む</summary>
            <div class="teacher-details-body">
              {teacher.detailProfile.map((detail) => <p>{detail}</p>)}
            </div>
          </details>
        </div>
      </section>
      <div class="school-greeting school-greeting-end" aria-label="相談メモの終わり">
        <strong>相談メモはここまで</strong>
        <span>迷う時は、使用を止めてから次の相談へ進みましょう。</span>
      </div>
    </article>
    <aside class="sidebar">
      <GlossaryBox title="この記事のミニ用語集" limit={4} />
      <RevenueCta variant={ctaVariant} />
    </aside>
  </section>
  {
    relatedProducts.length > 0 && (
      <section class="container section" id="mentioned-products">
        <div class="section-header">
          <div>
            <h2>関連商品</h2>
            <p>本文で触れた確認に使いやすい候補だけを絞っています。</p>
          </div>
        </div>
        <div class="grid curation-product-grid">
          {relatedProductRecommendations.map((recommendation, index) => (
            <ProductCard
              product={recommendation.product}
              pageType={`article-${article.slug}`}
              linkPosition="mentioned-products"
              variant="curation"
              sourceSlug={article.slug}
              slotIndex={index + 1}
              recommendationRole={recommendation.role}
            />
          ))}
        </div>
      </section>
    )
  }
  {
    showReplacement && (
      <section class="container section" id="replacement">
        <div class="section-header">
          <div>
            <p class="eyebrow">買い替え比較</p>
            <h2>買い替えを検討するなら、まず比較記事へ</h2>
            <p>部屋の広さ、工事費、年式を見てから候補を絞ると判断しやすくなります。</p>
          </div>
        </div>
        <div class="replacement-link-grid">
          <a
            href={sitePath("/by-size/")}
            data-cvr-action="article_replacement_by_size_click"
            data-action-kind="replacement"
            data-source-slug={article.slug}
            data-slot-index="1"
            data-recommendation-role="replacement"
            data-item-id="by-size"
          >
            <strong>畳数で買い替え候補を比べる</strong>
            <small>6畳・8畳・10畳・14畳など、部屋の広さから選ぶ。</small>
          </a>
          <a
            href={sitePath("/articles/installation-cost/")}
            data-cvr-action="article_replacement_cost_click"
            data-action-kind="replacement"
            data-source-slug={article.slug}
            data-slot-index="2"
            data-recommendation-role="replacement"
            data-item-id="installation-cost"
          >
            <strong>工事費の見方を確認する</strong>
            <small>標準工事、追加工事、電源条件まで先に見る。</small>
          </a>
          <a
            href={sitePath("/articles/aircon-history/")}
            data-cvr-action="article_replacement_age_click"
            data-action-kind="replacement"
            data-source-slug={article.slug}
            data-slot-index="3"
            data-recommendation-role="replacement"
            data-item-id="aircon-history"
          >
            <strong>年式と省エネ性能を確認する</strong>
            <small>古い機種の電気代や買い替え目安を整理する。</small>
          </a>
        </div>
      </section>
    )
  }
</BaseLayout>
