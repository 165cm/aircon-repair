---
import { getCollection } from "astro:content";
import { productCategories } from "@data/products";

export async function getStaticPaths() {
  const articles = await getCollection("articles");
  const staticPaths = [
    "about",
    "articles",
    "basics",
    "by-size",
    "cleaning-prevention",
    "contact",
    "diagnosis",
    "disclaimer",
    "jobs",
    "privacy",
    "products",
    "sitemap.xml"
  ];

  return [
    ...staticPaths.map((path) => ({ params: { path } })),
    ...articles.map((article) => ({ params: { path: `articles/${article.slug}` } })),
    ...productCategories.map((product) => ({ params: { path: `products/${product.id}` } }))
  ];
}

const path = Astro.params.path ?? "";
const normalizedPath = path.replace(/^\/+/, "");
const target = path
  ? normalizedPath.includes(".")
    ? `/${normalizedPath}`
    : `/${normalizedPath.replace(/\/?$/, "/")}`
  : "/";
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <title>Redirecting to {target}</title>
    <script is:inline define:vars={{ target }}>
      window.location.replace(target);
    </script>
  </head>
  <body>
    <p><a href={target}>ページを開く</a></p>
  </body>
</html>
