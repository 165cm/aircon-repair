---
import { getCollection } from "astro:content";
import AmazonLink from "@components/AmazonLink.astro";
import ArticleCard from "@components/ArticleCard.astro";
import ProductGrid from "@components/ProductGrid.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { amazonProductUrl, amazonSearchUrl } from "@data/affiliate";
import { getProductRelatedArticles, getRelatedProductsForProduct } from "@data/internalLinks";
import { categoryLabels, productCategories, type ProductCategory } from "@data/products";
import { absoluteUrl, sitePath } from "@utils/paths";

export function getStaticPaths() {
  return productCategories.map((product) => ({
    params: { id: product.id },
    props: { product }
  }));
}

const { product } = Astro.props as { product: ProductCategory };
const related = getRelatedProductsForProduct(product);
const relatedArticles = getProductRelatedArticles(product, await getCollection("articles"));
const categoryLabel = product.category ? categoryLabels[product.category] : "商品候補";
const makerRecommendations = product.makerRecommendations ?? [];
const choiceGuide = product.choiceGuide;
const canonical = absoluteUrl(`/products/${product.id}/`);
const productDisplayName = product.choiceName ?? product.name;
const pageTitle = choiceGuide ? `${productDisplayName}の選び方・おすすめ候補` : product.name;
const pageDescription = choiceGuide
  ? `${productDisplayName}を選ぶ前に見るポイント、後悔しやすい注意点、おすすめ候補を安全重視で比較します。`
  : `${product.name}の用途、向いている症状、購入前の注意点を安全重視でまとめています。`;
const breadcrumbs = [
  { label: "ホーム", href: "/" },
  { label: "商品比較", href: "/products/" },
  { label: pageTitle }
];
const isReplacement = product.type === "replacement";
const amazonLabel = isReplacement
  ? "工事費込み候補を確認する"
  : product.category === "remote"
    ? "対応機種・価格を確認する"
    : "仕様・価格を確認する";
const makerSearchBase = product.name.replace(/候補|工事費込み|ルームエアコン|省エネ|大型/g, "").replace(/\s+/g, " ").trim();
const makerAmazonUrl = (recommendation: NonNullable<ProductCategory["makerRecommendations"]>[number]) =>
  amazonSearchUrl(recommendation.amazonKeyword ?? `${recommendation.maker} エアコン ${makerSearchBase} 工事費込み`);
const choiceAmazonUrl = (option: NonNullable<ProductCategory["choiceGuide"]>["options"][number]) =>
  amazonSearchUrl(option.amazonKeyword);
const reviewCandidateUrl = (candidate: NonNullable<NonNullable<ProductCategory["choiceGuide"]>["reviewCandidates"]>[number]) =>
  candidate.amazonAsin ? amazonProductUrl(candidate.amazonAsin) : amazonSearchUrl(candidate.amazonKeyword ?? candidate.productName);
const defaultReviewCriteria = ["用途適合", "使いやすさ", "手入れ", "安全性", "価格納得感"];
const displayReviewCriteria = choiceGuide?.reviewCriteria ?? (choiceGuide ? defaultReviewCriteria : undefined);
const generatedReviewCandidates = choiceGuide?.options.map((option, index) => {
  const optionNotes = [
    option.bestFor,
    option.pros?.[0] ?? option.reason,
    option.pros?.[1] ?? (option.cons?.[0] ? `注意: ${option.cons[0]}` : "価格だけでなく、対応範囲と使う場所をリンク先で確認します。"),
    option.cons?.[1] ? `注意: ${option.cons[1]}` : "公式仕様とレビューを見て、使いたい部屋に合うかを確認します。",
    "安全に使える範囲を超えそうなら、購入より先に業者相談を優先します。"
  ];

  return {
    label: option.label,
    productName: option.productName,
    bestFor: option.bestFor,
    usp: option.reason,
    referencePrice: product.priceBand ?? "リンク先で確認",
    amazonKeyword: option.amazonKeyword,
    source: option.source,
    scores: defaultReviewCriteria.map((label, scoreIndex) => ({
      label,
      score: Math.max(76, 90 - index * 3 - scoreIndex),
      note: optionNotes[scoreIndex] ?? option.reason
    }))
  };
}) ?? [];
const reviewCandidates = (choiceGuide?.reviewCandidates ?? generatedReviewCandidates)
  .map((candidate) => ({
    ...candidate,
    totalScore: Math.round(candidate.scores.reduce((sum, score) => sum + score.score, 0) / candidate.scores.length)
  }))
  .sort((a, b) => b.totalScore - a.totalScore);
const topReviewCandidates = reviewCandidates.slice(0, 2);
const runnerUpCandidates = reviewCandidates.slice(2);
const purchaseChecks = isReplacement
  ? [
      "標準工事込み / 追加費用",
      "畳数・木造/鉄筋・日当たり",
      "100V/200V・専用回路・コンセント形状",
      "室外機置き場・配管穴・搬入経路・撤去費",
      "保証年数・工事日・リサイクル費"
    ]
  : [
      "症状に合う用途",
      "サイズ・対応機種・設置場所・消耗品",
      "分解なしで使える範囲",
      "公式仕様・注意書き",
      "水漏れ/異音/焦げ臭い時は業者優先"
    ];
const stopChecks = isReplacement
  ? [
      "200V/専用回路の変更が必要",
      "高所・屋根置き・壁面置き",
      "冷媒・配管・電気工事に触れる"
    ]
  : [
      "内部・基板・ファン・冷媒配管に触れる",
      "水漏れが天井や壁内へ広がる",
      "焦げ臭い / 異音大 / ブレーカー停止"
    ];
const faqs = [
  {
    question: `${productDisplayName}はどんな人に向いていますか？`,
    answer: product.bestFor ?? product.description
  },
  {
    question: "購入前に一番確認すべきことは何ですか？",
    answer: purchaseChecks[0]
  },
  {
    question: "自分で作業してはいけないケースはありますか？",
    answer: stopChecks[0]
  }
];
const jsonLd = [{
  "@context": "https://schema.org",
  "@type": "Product",
  name: pageTitle,
  brand: product.brand,
  category: categoryLabel,
  description: product.description,
  image: product.image ? absoluteUrl(product.image) : undefined,
  offers: {
    "@type": "Offer",
    url: canonical,
    availability: "https://schema.org/InStock"
  }
}, {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: faq.answer
    }
  }))
}];
---

<BaseLayout title={pageTitle} description={pageDescription} canonical={canonical} jsonLd={jsonLd} ogImage={product.image} breadcrumbs={breadcrumbs}>
  <section class="container section">
    <p class="eyebrow">{categoryLabel}</p>
    <h1>{pageTitle}</h1>
    <p class="lead">{product.description}</p>
    <div class="tag-list">
      {product.priceBand && <span class="tag">価格帯目安: {product.priceBand}</span>}
      {product.symptoms.map((symptom) => <span class="tag">{symptom}</span>)}
    </div>
  </section>

  <section class:list={["container section product-detail", choiceGuide && "product-detail-intro"]}>
    <div class="panel product-image-panel">
      {product.image && <img class="product-detail-image" src={sitePath(product.image)} alt={`${productDisplayName}のイメージ画像`} />}
    </div>
    <div class="panel">
      {choiceGuide ? (
        <div class="product-choice-summary">
          <p class="eyebrow">選ぶ前にここだけ確認</p>
          <h2>{productDisplayName}で見るポイント</h2>
          <ul class="product-quick-list">
            {product.bestFor && (
              <li>
                <span>使い道</span>
                <strong>{product.bestFor}</strong>
              </li>
            )}
            {product.priceBand && (
              <li>
                <span>価格帯</span>
                <strong>{product.priceBand}</strong>
              </li>
            )}
            <li>
              <span>安全ライン</span>
              <strong>{product.safetyNote}</strong>
            </li>
          </ul>
          <a class="inline-link" href="#choice-guide">候補比較へ進む</a>
        </div>
      ) : (
        <>
          <h2>購入前に見るポイント</h2>
          <dl class="detail-list">
            {product.brand && <><dt>ブランド/候補</dt><dd>{product.brand}</dd></>}
            {product.bestFor && <><dt>向いている使い方</dt><dd>{product.bestFor}</dd></>}
            {product.whyPick && <><dt>ピックアップ理由</dt><dd>{product.whyPick}</dd></>}
            {product.reviewSummary && <><dt>レビュー調査メモ</dt><dd>{product.reviewSummary}</dd></>}
            <dt>安全メモ</dt><dd>{product.safetyNote}</dd>
          </dl>
          {product.reviewSources && product.reviewSources.length > 0 && (
            <div>
              <h3>参考にした情報</h3>
              <ul class="source-list">
                {product.reviewSources.map((source) => (
                  <li><a href={source.url} rel="sponsored nofollow noopener" target="_blank">{source.label}</a></li>
                ))}
              </ul>
            </div>
          )}
          {product.cautions && product.cautions.length > 0 && (
            <div class="notice">
              <h3>注意点</h3>
              <ul>{product.cautions.map((caution) => <li>{caution}</li>)}</ul>
            </div>
          )}
          <div class="button-row">
            <AmazonLink product={product} pageType="product-detail" linkPosition="hero" label={amazonLabel} />
            <a class="button secondary" href={sitePath("/products/")}>商品一覧へ戻る</a>
          </div>
        </>
      )}
    </div>
  </section>

  {choiceGuide && (
    <section id="choice-guide" class="container section choice-guide">
      <div class="section-header compact">
        <div>
          <p class="eyebrow">{reviewCandidates.length > 2 ? "5候補比較" : "迷わない2択"}</p>
          <h2>{reviewCandidates.length > 2 ? `${productDisplayName}のおすすめ候補を比較` : `${productDisplayName}はどちらを選ぶ？`}</h2>
          <p>{choiceGuide.intro}</p>
        </div>
      </div>
      <div class="choice-guide-layout">
        <aside class="choice-regret-box">
          <p class="eyebrow">安い商品で後悔しやすいこと</p>
          <ul>
            {choiceGuide.regrets.map((regret) => <li>{regret}</li>)}
          </ul>
        </aside>
        {reviewCandidates.length > 0 ? (
          <>
            {displayReviewCriteria && (
              <div class="review-criteria-strip" aria-label="採点項目">
                {displayReviewCriteria.map((criterion) => <span>{criterion}</span>)}
              </div>
            )}
            <div class="review-top-grid">
              {topReviewCandidates.map((candidate, index) => (
                <article class="review-candidate-card">
                  <div class="review-candidate-head">
                    <span>{candidate.label}</span>
                    <strong>参考価格 {candidate.referencePrice}</strong>
                  </div>
                  <h3>{candidate.productName}</h3>
                  <p class="choice-option-fit">{candidate.bestFor}</p>
                  <p>{candidate.usp}</p>
                  <ul class="review-note-list">
                    {candidate.scores.slice(0, 3).map((score) => <li>{score.note}</li>)}
                  </ul>
                  <div class="choice-option-actions">
                    <a
                      class="button choice-amazon-button"
                      href={reviewCandidateUrl(candidate)}
                      rel="sponsored nofollow noopener"
                      target="_blank"
                      data-amazon-link
                      data-cvr-action={product.type === "replacement" ? "amazon_replacement_click" : "amazon_support_click"}
                      data-action-kind={product.type === "replacement" ? "replacement" : "products"}
                      data-item-id={`${product.id}-review-${index + 1}`}
                      data-item-name={candidate.productName}
                      data-page-type="product-detail"
                      data-link-position={`review-top-${index + 1}`}
                      data-source-slug={product.id}
                      data-slot-index={index + 1}
                      data-recommendation-role="review-top-candidate"
                    >
                      Amazonで評判を見る
                    </a>
                    {candidate.source && <a class="inline-link" href={candidate.source.url} rel="noopener" target="_blank">公式情報を見る</a>}
                  </div>
                </article>
              ))}
            </div>
            {runnerUpCandidates.length > 0 && (
              <div class="review-runner-list">
                <p class="eyebrow">ほかの候補</p>
                {runnerUpCandidates.map((candidate, index) => (
                  <article>
                    <div>
                      <strong>{candidate.productName}</strong>
                      <span>参考価格 {candidate.referencePrice}</span>
                    </div>
                    <p>{candidate.usp}</p>
                    <div class="review-runner-actions">
                      <a
                        class="inline-link"
                        href={reviewCandidateUrl(candidate)}
                        rel="sponsored nofollow noopener"
                        target="_blank"
                        data-amazon-link
                        data-cvr-action={product.type === "replacement" ? "amazon_replacement_click" : "amazon_support_click"}
                        data-action-kind={product.type === "replacement" ? "replacement" : "products"}
                        data-item-id={`${product.id}-runner-${index + 1}`}
                        data-item-name={candidate.productName}
                        data-page-type="product-detail"
                        data-link-position={`review-runner-${index + 1}`}
                        data-source-slug={product.id}
                        data-slot-index={index + 3}
                        data-recommendation-role="review-runner-candidate"
                      >
                        Amazonで評判を見る
                      </a>
                      {candidate.source && <a class="inline-link" href={candidate.source.url} rel="noopener" target="_blank">公式情報を見る</a>}
                    </div>
                  </article>
                ))}
              </div>
            )}
          </>
        ) : (
          <div class="choice-option-grid">
            {choiceGuide.options.map((option, index) => (
              <article class="choice-option-card">
                <div class="choice-option-head">
                  <span>{option.label}</span>
                  <h3>{option.productName}</h3>
                </div>
                <p class="choice-option-fit">{option.bestFor}</p>
                <p>{option.reason}</p>
                {(option.pros || option.cons) && (
                  <div class="choice-compare-points">
                    {option.pros && (
                      <div class="choice-point-group is-pro">
                        <h4>メリット</h4>
                        <ul>{option.pros.map((point) => <li>{point}</li>)}</ul>
                      </div>
                    )}
                    {option.cons && (
                      <div class="choice-point-group is-con">
                        <h4>デメリット</h4>
                        <ul>{option.cons.map((point) => <li>{point}</li>)}</ul>
                      </div>
                    )}
                  </div>
                )}
                <div class="choice-option-actions">
                  <a
                    class="button choice-amazon-button"
                    href={choiceAmazonUrl(option)}
                    rel="sponsored nofollow noopener"
                    target="_blank"
                    data-amazon-link
                    data-cvr-action={product.type === "replacement" ? "amazon_replacement_click" : "amazon_support_click"}
                    data-action-kind={product.type === "replacement" ? "replacement" : "products"}
                    data-item-id={`${product.id}-choice-${index + 1}`}
                    data-item-name={option.productName}
                    data-page-type="product-detail"
                    data-link-position={`choice-${index + 1}`}
                    data-source-slug={product.id}
                    data-slot-index={index + 1}
                    data-recommendation-role="choice-comparison"
                  >
                    Amazonで評判を見る
                  </a>
                  {option.source && <a class="inline-link" href={option.source.url} rel="noopener" target="_blank">{option.source.label}</a>}
                </div>
              </article>
            ))}
          </div>
        )}
      </div>
      <p class="choice-verdict">{choiceGuide.verdict}</p>
    </section>
  )}

  {makerRecommendations.length > 0 && (
    <section class="container section maker-recommendations">
      <div class="section-header">
        <div>
          <p class="eyebrow">メーカーで選ぶ</p>
          <h2>この畳数でおすすめの3メーカー</h2>
          <p>同じ畳数でも、部屋の使い方や設置条件で合うメーカーは変わります。まずは自分の部屋に近い条件から比べてください。</p>
        </div>
      </div>
      <div class="maker-recommendation-grid">
        {makerRecommendations.map((recommendation, index) => (
          <article class={`maker-recommendation-card${recommendation.isPick ? " is-pick" : ""}`}>
            <div class="maker-recommendation-head">
              <span>{String(index + 1).padStart(2, "0")}</span>
              <div>
                {recommendation.isPick && <small>海外・個性派ピック</small>}
                <h3>{recommendation.maker}</h3>
              </div>
            </div>
            <p class="maker-recommendation-fit">{recommendation.bestFor}</p>
            <dl class="maker-recommendation-points">
              <dt class="point-strength"><span aria-hidden="true">✅</span>強み</dt>
              <dd><strong>{recommendation.strengthKeyword ?? "注目機能"}</strong>{recommendation.strength}</dd>
              <dt class="point-weakness"><span aria-hidden="true">⚠️</span>弱み</dt>
              <dd><strong>{recommendation.weaknessKeyword ?? "確認点"}</strong>{recommendation.weakness}</dd>
              <dt class="point-choice"><span aria-hidden="true">🧭</span>選び方</dt>
              <dd><strong>{recommendation.howToChooseKeyword ?? "選ぶ基準"}</strong>{recommendation.howToChoose}</dd>
            </dl>
            <div class="maker-recommendation-actions">
              <a
                class="maker-amazon-button"
                href={makerAmazonUrl(recommendation)}
                rel="sponsored nofollow noopener"
                target="_blank"
                data-amazon-link
                data-cvr-action="amazon_replacement_click"
                data-action-kind="replacement"
                data-item-id={`${product.id}-${recommendation.maker}`}
                data-item-name={`${product.name} ${recommendation.maker}`}
                data-page-type="product-detail"
                data-link-position={`maker-${index + 1}`}
                data-source-slug={product.id}
                data-slot-index={index + 1}
                data-recommendation-role={recommendation.isPick ? "maker-pick" : "maker-recommendation"}
              >
                <span aria-hidden="true">🛒</span>Amazonで探す
              </a>
              <a class="inline-link" href={recommendation.source.url} rel="noopener" target="_blank">公式情報を見る</a>
            </div>
          </article>
        ))}
      </div>
    </section>
  )}

  <section class="container section">
    <div class="grid two">
      <div class="card">
        <p class="eyebrow">購入前チェック</p>
        <h2>リンク先で見る項目</h2>
        <ul class="check-list">
          {purchaseChecks.map((check) => <li>{check}</li>)}
        </ul>
        <div class="button-row">
          <AmazonLink product={product} pageType="product-detail" linkPosition="checklist" label="Amazonで仕様・在庫を見る" />
        </div>
      </div>
      <div class="card">
        <p class="eyebrow">安全境界線</p>
        <h2>購入より先に相談する目安</h2>
        <ul class="check-list danger-list">
          {stopChecks.map((check) => <li>{check}</li>)}
        </ul>
        <div class="button-row">
          <a class="button warm" href={sitePath("/diagnosis/")} data-cvr-action="product_diagnosis_click" data-action-kind="safe">症状を相談する</a>
          <a class="button secondary" href={sitePath("/articles/call-contractor/")} data-cvr-action="product_contractor_article_click" data-action-kind="contractor">業者を呼ぶ目安</a>
        </div>
      </div>
    </div>
  </section>

  <section class="container section">
    <div class="notice safe">
      {isReplacement
        ? "エアコン本体は高単価ですが、設置工事の条件で総額が変わります。購入前に工事範囲と追加費用を確認し、不明点は販売店・工事業者へ相談してください。"
        : "補助用品はあくまで安全な切り分けや予防のための候補です。症状が強い時や本体内部の作業が必要な時は、商品購入より専門業者への相談を優先してください。"}
    </div>
  </section>

  {relatedArticles.length > 0 && (
    <section class="container section">
      <div class="section-header">
        <div>
          <p class="eyebrow">関連記事</p>
          <h2>この商品を検討する前に読む記事</h2>
        </div>
      </div>
      <div class="grid">
        {relatedArticles.map((article, index) => (
          <ArticleCard
            article={article}
            sourceSlug={product.id}
            slotIndex={index + 1}
            recommendationRole="product-before-buying"
          />
        ))}
      </div>
    </section>
  )}

  {related.length > 0 && (
    <section class="container section">
      <div class="section-header">
        <div>
          <p class="eyebrow">関連商品</p>
          <h2>同じ症状で比較されやすい候補</h2>
        </div>
      </div>
      <ProductGrid products={related} pageType="product-detail" linkPosition="related" sourceSlug={product.id} recommendationRole="related-product" />
    </section>
  )}
</BaseLayout>
