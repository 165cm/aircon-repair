---
import { getCollection } from "astro:content";
import ArticleCard from "@components/ArticleCard.astro";
import ProductGrid from "@components/ProductGrid.astro";
import RevenueCta from "@components/RevenueCta.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getCanonicalArticles } from "@data/internalLinks";

const articles = getCanonicalArticles(await getCollection("articles"))
  .filter((article) => article.data.category === "cleaning")
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
  title="掃除・故障予防"
  description="フィルター掃除、室外機まわり、ドレンホース、掃除スプレーの注意点を安全重視でまとめています。"
>
  <section class="container section">
    <p class="eyebrow">繁忙期前の予防</p>
    <h1>掃除・故障予防</h1>
    <p class="lead">安全にできるのは主にフィルター、外装、室外機まわり、ドレンホース先端の確認です。内部洗浄は無理に行いません。</p>
  </section>
  <section class="container section">
    <div class="grid">
      {articles.map((article) => <ArticleCard article={article} />)}
    </div>
  </section>
  <section class="container section">
    <ProductGrid />
  </section>
  <section class="container section">
    <RevenueCta variant="contractor" />
  </section>
</BaseLayout>
