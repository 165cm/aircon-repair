---
import { getCollection } from "astro:content";
import ArticleCard from "@components/ArticleCard.astro";
import ActionPanel, { type ActionItem } from "@components/ActionPanel.astro";
import DiagnosisChat from "@components/DiagnosisChat.astro";
import GlossaryBox from "@components/GlossaryBox.astro";
import ProductGrid from "@components/ProductGrid.astro";
import RevenueCta from "@components/RevenueCta.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { affiliate } from "@data/affiliate";
import { replacementProducts, supportProducts } from "@data/products";
import { sitePath } from "@utils/paths";

const articles = (await getCollection("articles")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const featured = articles.slice(0, 6);
const replacementSteps = [
  {
    label: "1",
    title: "修理見積もりを見直す",
    body: "新品本体の半額に近いなら比較開始",
    href: "/articles/installation-cost/"
  },
  {
    label: "2",
    title: "部屋の広さを合わせる",
    body: "畳数不足なら冷えない原因にもなる",
    href: "/by-size/"
  },
  {
    label: "3",
    title: "本体候補を比べる",
    body: "工事費込みで総額の目安を見る",
    href: "#replacement-candidates"
  }
];
const heroActions = [
  {
    kind: "safe",
    label: "冷えない・暑い",
    href: "/diagnosis/#not-cooling",
    body: "温湿度・フィルター・室外機まわりを確認",
    action: "home_symptom_not_cooling_click",
    icon: "cooling",
    primary: true
  },
  {
    kind: "contractor",
    label: "水漏れする",
    href: "/diagnosis/#water-leak",
    body: "電源まわりを避け、排水経路だけ安全確認",
    action: "home_symptom_water_leak_click",
    icon: "leak"
  },
  {
    kind: "contractor",
    label: "異音・振動",
    href: "/diagnosis/#noise",
    body: "金属音・焦げ臭さは使用停止を優先",
    action: "home_symptom_noise_click",
    icon: "noise"
  },
  {
    kind: "products",
    label: "リモコン不調",
    href: "/diagnosis/#remote",
    body: "電池・送信部・応急運転で切り分け",
    action: "home_symptom_remote_click",
    icon: "remote"
  }
] satisfies ActionItem[];
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: affiliate.siteName,
  url: affiliate.siteUrl,
  potentialAction: {
    "@type": "SearchAction",
    target: `${affiliate.siteUrl}/articles/?q={search_term_string}`,
    "query-input": "required name=search_term_string"
  }
};
---

<BaseLayout
  title={affiliate.siteName}
  description="エアコンの冷えない、水漏れ、異音、掃除の悩みを安全に切り分け、補助用品・業者相談・求人情報へ案内する初心者向けサイト。"
  jsonLd={jsonLd}
>
  <section class="container hero home-hero">
    <div>
      <p class="eyebrow">エアコン修理の3分診断</p>
      <h1>故障かもと思ったら、まず修理か買い替えかを決める</h1>
      <p class="lead">
        冷えない・水漏れ・異音・リモコン不調を、危険な分解に進まず切り分けます。
        症状と使用状況を選ぶだけで、修理相談を優先するか、買い替え比較まで進めるかが分かります。
      </p>
      <div class="trust-strip" aria-label="サイトの安全方針">
        <span>外側から見られる範囲だけ</span>
        <span>危険サインは使用停止を優先</span>
        <span>10年以上なら新品候補も比較</span>
      </div>
      <div class="hero-actions">
        <a class="button" href="#chat-title" data-cvr-action="home_diagnosis_start_click" data-action-kind="safe">いますぐ診断する</a>
        <a class="button warm" href={sitePath("/by-size/")} data-cvr-action="home_replacement_compare_click" data-action-kind="replacement">畳数で買い替え比較</a>
        <a class="button secondary" href={sitePath("/articles/call-contractor/")} data-cvr-action="home_repair_consult_click" data-action-kind="contractor">修理を呼ぶ目安</a>
      </div>
    </div>
    <DiagnosisChat />
  </section>

  <section class="container section tight-section">
    <ActionPanel
      eyebrow="症状から最短で選ぶ"
      title="いま近い症状を選ぶと、次の安全な行動へ進めます"
      description="記事を探す前に、危険度・確認範囲・商品/業者/買い替えの目安を切り分けます。"
      items={heroActions}
      image="/images/safe-check-flow.webp"
      imageAlt="フィルター、リモコン、室外機まわりを安全に確認するイメージ"
    />
  </section>

  <section class="container section">
    <GlossaryBox limit={4} />
  </section>

  <section class="container section">
    <div class="section-header">
      <div>
        <p class="eyebrow">修理費が高い時の次の一手</p>
        <h2>修理するか買い替えるか、先に費用感を比べる</h2>
        <p>「直してもまた壊れそう」「見積もりが思ったより高い」と感じたら、修理だけで決めずに同じ部屋へ置ける新品候補も見ておくと判断しやすくなります。</p>
      </div>
      <a href={sitePath("/by-size/")}>部屋に合う新品候補を見る</a>
    </div>
    <div class="decision-steps" aria-label="買い替え判断の順番">
      {
        replacementSteps.map((step) => (
          <a class="decision-step" href={step.href.startsWith("#") ? step.href : sitePath(step.href)}>
            <span>{step.label}</span>
            <strong>{step.title}</strong>
            <small>{step.body}</small>
          </a>
        ))
      }
    </div>
    <div class="section-header product-section-title" id="replacement-candidates">
      <div>
        <p class="eyebrow">本体候補</p>
        <h2>まず比較したい買い替え候補</h2>
      </div>
    </div>
    <ProductGrid products={replacementProducts} pageType="home" linkPosition="by-size-replacement" variant="comparison" />
  </section>

  <section class="container section">
    <div class="section-header">
      <div>
        <p class="eyebrow">安全な範囲の備え</p>
        <h2>分解しない補助用品から整える</h2>
        <p>価格は固定表示せず、個別の商品候補からAmazonの商品ページで仕様・在庫を確認できるようにしています。</p>
      </div>
      <a href={sitePath("/products/")}>商品比較へ</a>
    </div>
    <ProductGrid products={supportProducts} pageType="home" linkPosition="support-curation" variant="curation" />
  </section>

  <section class="container section">
    <div class="grid two">
      <RevenueCta variant="contractor" />
      <RevenueCta variant="replacement" />
    </div>
  </section>

  <section class="container section">
    <div class="section-header">
      <div>
        <p class="eyebrow">初期記事</p>
        <h2>まず読んでほしい基礎と症状別ガイド</h2>
      </div>
      <a href={sitePath("/basics/")}>記事一覧へ</a>
    </div>
    <div class="grid">
      {featured.map((article) => <ArticleCard article={article} />)}
    </div>
  </section>
</BaseLayout>
