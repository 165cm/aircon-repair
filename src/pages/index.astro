---
import { getCollection } from "astro:content";
import ArticleCard from "@components/ArticleCard.astro";
import ActionPanel, { type ActionItem } from "@components/ActionPanel.astro";
import DiagnosisWidget from "@components/DiagnosisWidget.astro";
import GlossaryBox from "@components/GlossaryBox.astro";
import ProductGrid from "@components/ProductGrid.astro";
import RevenueCta from "@components/RevenueCta.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { affiliate } from "@data/affiliate";
import { replacementProducts } from "@data/products";
import { sitePath } from "@utils/paths";

const articles = (await getCollection("articles")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const featured = articles.slice(0, 6);
const buyingArticles = articles
  .filter((article) => article.data.category === "buying")
  .sort((a, b) => {
    const order = ["aircon-6jou-choose", "aircon-8jou-choose", "aircon-10jou-choose", "aircon-14jou-choose", "aircon-18jou-choose"];
    return order.indexOf(a.slug) - order.indexOf(b.slug);
  })
  .slice(0, 3);
const heroActions = [
  {
    kind: "safe",
    label: "冷えない・暑い",
    href: "/diagnosis/#not-cooling",
    body: "温湿度・フィルター・室外機まわりを確認",
    action: "home_symptom_not_cooling_click",
    primary: true
  },
  {
    kind: "contractor",
    label: "水漏れする",
    href: "/diagnosis/#water-leak",
    body: "電源まわりを避け、排水経路だけ安全確認",
    action: "home_symptom_water_leak_click"
  },
  {
    kind: "contractor",
    label: "異音・振動",
    href: "/diagnosis/#noise",
    body: "金属音・焦げ臭さは使用停止を優先",
    action: "home_symptom_noise_click"
  },
  {
    kind: "products",
    label: "リモコン不調",
    href: "/diagnosis/#remote",
    body: "電池・送信部・応急運転で切り分け",
    action: "home_symptom_remote_click"
  }
] satisfies ActionItem[];
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: affiliate.siteName,
  url: affiliate.siteUrl,
  potentialAction: {
    "@type": "SearchAction",
    target: `${affiliate.siteUrl}/articles/?q={search_term_string}`,
    "query-input": "required name=search_term_string"
  }
};
---

<BaseLayout
  title={affiliate.siteName}
  description="エアコンの冷えない、水漏れ、異音、掃除の悩みを安全に切り分け、補助用品・業者相談・求人情報へ案内する初心者向けサイト。"
  jsonLd={jsonLd}
>
  <section class="container hero">
    <div>
      <p class="eyebrow">エアコン修理の放課後ノート</p>
      <h1>エアコンの不調を、危ない作業に進む前に切り分ける</h1>
      <p class="lead">
        冷えない・水漏れ・異音・掃除の困りごとを、高校生でも分かる言葉で整理します。
        自分で見てよい場所、業者へ任せるサイン、買い替えを比較する目安を最短で確認できます。
      </p>
      <div class="trust-strip" aria-label="サイトの安全方針">
        <span>分解修理を推奨しない</span>
        <span>危険サインを先に表示</span>
        <span>広告リンクは明記</span>
      </div>
      <div class="hero-actions">
        <a class="button" href={sitePath("/diagnosis/")} data-cvr-action="home_diagnosis_start_click" data-action-kind="safe">症状診断を始める</a>
        <a class="button warm" href={sitePath("/by-size/")} data-cvr-action="home_replacement_compare_click" data-action-kind="replacement">畳数で買い替え比較</a>
        <a class="button secondary" href={sitePath("/products/")} data-cvr-action="home_products_click" data-action-kind="products">補助用品を見る</a>
      </div>
    </div>
    <div class="panel visual-panel hero-trust-visual" aria-label="室内エアコンと温湿度計の写真イメージ"></div>
  </section>

  <section class="container section tight-section">
    <ActionPanel
      eyebrow="症状から最短で選ぶ"
      title="いま近い症状を選ぶと、次の安全な行動へ進めます"
      description="記事を探す前に、危険度・確認範囲・商品/業者/買い替えの目安を切り分けます。"
      items={heroActions}
      image="/images/safe-check-flow.webp"
      imageAlt="フィルター、リモコン、室外機まわりを安全に確認するイメージ"
    />
  </section>

  <section class="container section">
    <DiagnosisWidget />
  </section>

  <section class="container section">
    <GlossaryBox limit={4} />
  </section>

  <section class="container section">
    <div class="section-header">
      <div>
        <p class="eyebrow">修理費が高い時の次の一手</p>
        <h2>畳数でエアコン本体を比較する</h2>
        <p>10年以上使っている、修理見積もりが高い、部屋の広さに合っていない時は、6畳・8畳・10畳・14畳の選び方から確認します。</p>
      </div>
      <a href={sitePath("/by-size/")}>畳数ガイドへ</a>
    </div>
    <div class="grid">
      {buyingArticles.map((article) => <ArticleCard article={article} />)}
    </div>
    <div class="section-header product-section-title">
      <div>
        <p class="eyebrow">本体候補</p>
        <h2>まず比較したい買い替え候補</h2>
      </div>
    </div>
    <ProductGrid products={replacementProducts} pageType="home" linkPosition="by-size-replacement" />
  </section>

  <section class="container section">
    <div class="section-header">
      <div>
        <p class="eyebrow">安全な範囲の備え</p>
        <h2>分解しない補助用品から整える</h2>
        <p>価格は固定表示せず、個別の商品候補からAmazonの商品ページで仕様・在庫を確認できるようにしています。</p>
      </div>
      <a href={sitePath("/products/")}>商品比較へ</a>
    </div>
    <ProductGrid />
  </section>

  <section class="container section">
    <div class="grid two">
      <RevenueCta variant="contractor" />
      <RevenueCta variant="replacement" />
    </div>
  </section>

  <section class="container section">
    <div class="section-header">
      <div>
        <p class="eyebrow">初期記事</p>
        <h2>まず読んでほしい基礎と症状別ガイド</h2>
      </div>
      <a href={sitePath("/basics/")}>記事一覧へ</a>
    </div>
    <div class="grid">
      {featured.map((article) => <ArticleCard article={article} />)}
    </div>
  </section>
</BaseLayout>
