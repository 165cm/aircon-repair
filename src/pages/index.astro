---
import DiagnosisChat from "@components/DiagnosisChat.astro";
import EmergencyAlert from "@components/EmergencyAlert.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { affiliate } from "@data/affiliate";
import { sitePath } from "@utils/paths";

// 検索から来た読者が最初に押す入口。チャットの症状（not-cooling / water-leak / noise / remote / cleaning）に合わせ、
// 追加の1件だけ記事へ逃がす。数を増やすほど迷うので、6件で固定する。
const heroSymptoms = [
  { label: "冷えない", body: "風がぬるい・効かない", symptom: "not-cooling", href: "#chat-title" },
  { label: "水が漏れる", body: "室内機や壁から落ちる", symptom: "water-leak", href: "#chat-title" },
  { label: "変な音がする", body: "ガタガタ・キーン", symptom: "noise", href: "#chat-title" },
  { label: "リモコンが効かない", body: "反応しない・表示が出ない", symptom: "remote", href: "#chat-title" },
  { label: "においが気になる", body: "カビ臭い・すっぱい", symptom: "cleaning", href: "#chat-title" },
  { label: "電気代が高い", body: "先月より急に上がった", href: "/articles/electric-bill-high/" }
];

// 相談のあとに読むページ。3枚だけに絞り、1枚3リンクまでにする。
const nextSteps = [
  {
    label: "読む",
    title: "症状をくわしく読む",
    body: "チャットのあと、同じ症状をじっくり確認したいときに。",
    links: [
      { label: "冷えない", href: "/articles/not-cooling/" },
      { label: "水もれ", href: "/articles/water-leak/" },
      { label: "変な音", href: "/articles/strange-noise/" }
    ]
  },
  {
    label: "呼ぶ",
    title: "修理を頼むか決める",
    body: "自分で見られる範囲を越えたら、頼む目安と費用を先に見ます。",
    links: [
      { label: "修理を呼ぶ目安", href: "/articles/call-contractor/" },
      { label: "メーカー問い合わせ先", href: "/maker-contacts/" },
      { label: "室外機の確認", href: "/articles/outdoor-unit-check/" }
    ]
  },
  {
    label: "替える",
    title: "買い替えも比べる",
    body: "10年以上使っている、見積もりが高い。そんなときの比べ方です。",
    links: [
      { label: "畳数で選ぶ", href: "/by-size/" },
      { label: "メーカー比較", href: "/articles/aircon-maker-compare/" },
      { label: "掃除と予防", href: "/cleaning-prevention/" }
    ]
  }
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: affiliate.siteName,
  url: affiliate.siteUrl,
  sameAs: [affiliate.xUrl],
  potentialAction: {
    "@type": "SearchAction",
    target: `${affiliate.siteUrl}/articles/?q={search_term_string}`,
    "query-input": "required name=search_term_string"
  }
};
---

<BaseLayout
  title={affiliate.siteName}
  description="冷えない、水もれ、変な音。エアコンの困りごとを風見先生が3分で整理して、自分で見ていい範囲と、修理を呼ぶ目安、買い替えの考え方まで案内します。"
  jsonLd={jsonLd}
>
  <section class="kazami-hero" aria-labelledby="home-title">
    <div class="container kazami-hero-grid">
      <div class="kazami-hero-copy">
        <p class="eyebrow">現場の知見をもとに、風見先生が案内</p>
        <h1 id="home-title">そのエアコン、<br />夏バテしてませんか？</h1>
        <p class="lead">どこまで自分で見ていいか、いつ修理を呼べばいいか。症状を選ぶだけで、風見先生が順番に整理します。</p>
        <a class="button" href="#chat-title" data-cvr-action="three_minute_diagnosis_start" data-action-kind="safe">3分の問診をはじめる</a>
      </div>
    </div>
    <div class="kazami-hero-shade" aria-hidden="true"></div>
    <img class="kazami-hero-background" src={sitePath("/images/kazami/kazami-hero-background-v2.webp")} alt="空調服ファン付きの白衣と腰道具を身に着け、明るい室内のエアコンを案内する修理技師の風見先生" width="1672" height="941" loading="eager" />
  </section>

  <section class="container symptom-section" aria-labelledby="symptom-title">
    <h2 id="symptom-title">いま、どれに近いですか？</h2>
    <p class="symptom-section-note">押すと、その症状から風見先生の問診がはじまります。</p>
    <div class="home-hero-symptoms" aria-label="症状を選んで相談を始める">
      {heroSymptoms.map((item) => (
        <a href={sitePath(item.href)} data-diagnosis-symptom={item.symptom} data-cvr-action="hero_symptom_click" data-action-kind="safe">
          <strong>{item.label}</strong><span>{item.body}</span><i aria-hidden="true">→</i>
        </a>
      ))}
    </div>
  </section>

  <section class="container emergency-section">
    <EmergencyAlert />
  </section>

  <section class="container section home-chat-section">
    <DiagnosisChat startClosed={false} showHeader={false} />
  </section>

  <section class="container section home-route-section" aria-labelledby="route-title">
    <h2 id="route-title">相談のあとに読むページ</h2>
    <div class="home-route-grid">
      {
        nextSteps.map((group) => (
          <article class="home-route-card">
            <div>
              <span>{group.label}</span>
              <h3>{group.title}</h3>
              <p>{group.body}</p>
            </div>
            <ul>
              {group.links.map((link) => (
                <li><a href={sitePath(link.href)}>{link.label}</a></li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
    <p class="home-route-more"><a href={sitePath("/articles/")}>記事をぜんぶ見る</a></p>
  </section>

  <script>
    document.addEventListener("click", (event) => {
      const targetEl = event.target instanceof Element ? event.target : event.target?.parentElement;
      const symptomTarget = targetEl?.closest("[data-diagnosis-symptom]");
      if (!symptomTarget) return;
      event.preventDefault();

      const label =
        symptomTarget.querySelector("strong")?.textContent?.trim() ??
        symptomTarget.textContent?.trim().replace(/\s+/g, " ");
      window.dispatchEvent(
        new CustomEvent("diagnosis:symptom", {
          detail: {
            symptomId: symptomTarget.dataset.diagnosisSymptom,
            label
          }
        })
      );
    });
  </script>
</BaseLayout>
