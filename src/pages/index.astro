---
import { getCollection } from "astro:content";
import DiagnosisChat from "@components/DiagnosisChat.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { affiliate } from "@data/affiliate";
import { getCanonicalArticles } from "@data/internalLinks";
import { articleThumbnail } from "@utils/articles";
import { sitePath } from "@utils/paths";

const latestArticles = getCanonicalArticles(await getCollection("articles"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf() || a.data.title.localeCompare(b.data.title, "ja"))
  .slice(0, 5);
const shortDate = new Intl.DateTimeFormat("ja-JP", { month: "numeric", day: "numeric" });

const routeGroups = [
  {
    label: "症状",
    title: "いまの困りごと",
    body: "冷えない、水もれ、変な音、リモコン不調を安全確認から見ます。",
    links: [
      { label: "症状チェック", href: "/diagnosis/" },
      { label: "冷えない", href: "/articles/not-cooling/" },
      { label: "水もれ", href: "/articles/water-leak/" },
      { label: "変な音", href: "/articles/strange-noise/" },
      { label: "リモコン", href: "/articles/remote-not-working/" }
    ]
  },
  {
    label: "安全",
    title: "止める？相談する？",
    body: "こげ臭い、火花、水が電源近くにある時は、先に止めます。",
    links: [
      { label: "あぶないサイン", href: "/diagnosis/#danger-signs" },
      { label: "相談の目安", href: "/articles/call-contractor/" },
      { label: "工事費を見る", href: "/articles/installation-cost/" },
      { label: "室外機を見る", href: "/articles/outdoor-unit-check/" }
    ]
  },
  {
    label: "買替",
    title: "修理費が高い時",
    body: "10年以上、いくつか症状がある、高い見積もりなら買い替えも見ます。",
    links: [
      { label: "畳数で選ぶ", href: "/by-size/" },
      { label: "LDK早見表", href: "/articles/aircon-ldk-size-guide/" },
      { label: "メーカーを見る", href: "/articles/aircon-maker-compare/" },
      { label: "6畳", href: "/articles/aircon-6jou-choose/" },
      { label: "10畳", href: "/articles/aircon-10jou-choose/" },
      { label: "14畳", href: "/articles/aircon-14jou-choose/" }
    ]
  },
  {
    label: "予防",
    title: "掃除・電気代・水",
    body: "分解しない範囲で、フィルター、ホース、室外機まわりを整えます。",
    links: [
      { label: "掃除と予防", href: "/cleaning-prevention/" },
      { label: "フィルター", href: "/articles/filter-cleaning/" },
      { label: "ドレンホース", href: "/articles/drain-hose/" },
      { label: "ホースの掃除", href: "/articles/drain-hose-cleaning/" },
      { label: "スプレー注意", href: "/articles/cleaning-spray-risk/" },
      { label: "電気代が高い", href: "/articles/electric-bill-high/" }
    ]
  },
  {
    label: "道具",
    title: "道具と本体候補",
    body: "確認に使う道具と買い替え候補は、診断後に見ます。",
    links: [
      { label: "商品比較", href: "/products/" },
      { label: "補助用品", href: "/products/#support" },
      { label: "本体候補", href: "/products/#replacement" },
      { label: "基礎知識", href: "/basics/" }
    ]
  },
  {
    label: "案内",
    title: "記事とサイト案内",
    body: "もっと読みたい時や、運営方針、広告表記を確認したい時はこちらです。",
    links: [
      { label: "記事一覧", href: "/articles/" },
      { label: "運営方針", href: "/about/" },
      { label: "求人・副業", href: "/jobs/" },
      { label: "広告表記", href: "/disclaimer/" }
    ]
  }
];
const heroSymptoms = [
  {
    label: "冷えない・暑い",
    symptom: "not-cooling",
    body: "風がぬるい、部屋が冷えない",
    action: "home_symptom_not_cooling_click"
  },
  {
    label: "水漏れする",
    symptom: "water-leak",
    body: "室内機や壁から水が落ちる",
    action: "home_symptom_water_leak_click"
  },
  {
    label: "異音・振動",
    symptom: "noise",
    body: "カタカタ、金属音、揺れがある",
    action: "home_symptom_noise_click"
  },
  {
    label: "リモコン不調",
    symptom: "remote",
    body: "反応しない、表示がおかしい",
    action: "home_symptom_remote_click"
  }
];
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: affiliate.siteName,
  url: affiliate.siteUrl,
  sameAs: [affiliate.xUrl],
  potentialAction: {
    "@type": "SearchAction",
    target: `${affiliate.siteUrl}/articles/?q={search_term_string}`,
    "query-input": "required name=search_term_string"
  }
};
---

<BaseLayout
  title={affiliate.siteName}
  description="エアコンの冷えない、水漏れ、異音、掃除の悩みを保健室の先生と安全に切り分け、修理相談か買い替え検討かを落ち着いて整理する初心者向けサイト。"
  jsonLd={jsonLd}
>
  <section class="home-hero-room" aria-labelledby="home-title">
    <img
      class="home-hero-room-image"
      src={sitePath("/images/aircon-health-room-hero.png")}
      alt=""
      loading="eager"
    />
    <div class="home-hero-room-shade"></div>
    <div class="container home-hero-room-inner">
      <div class="home-hero-copy">
        <p class="eyebrow">すずね先生の最初の質問</p>
        <h1 id="home-title">いま、どの症状ですか？</h1>
        <p class="lead">
          近いものを選ぶだけで、安全確認から修理相談、買い替え検討まで同じ順番で整理します。
        </p>
        <div class="home-hero-symptoms" aria-label="症状を選んで相談を始める">
          {
            heroSymptoms.map((item) => (
              <a
                href="#chat-title"
                data-diagnosis-symptom={item.symptom}
                data-cvr-action={item.action}
                data-action-kind="safe"
              >
                <strong>{item.label}</strong>
                <span>{item.body}</span>
              </a>
            ))
          }
        </div>
        <a class="home-danger-link" href={sitePath("/diagnosis/#danger-signs")} data-cvr-action="home_danger_signs_click" data-action-kind="contractor">
          焦げ臭い・火花・電源近くの水は先に停止
        </a>
      </div>
    </div>
  </section>

  <section class="latest-articles" aria-labelledby="latest-articles-title">
    <div class="container latest-articles-inner">
      <div class="latest-articles-heading">
        <span>NEW</span>
        <h2 id="latest-articles-title">新着記事</h2>
      </div>
      <div class="latest-articles-list">
        {
          latestArticles.map((article, index) => (
            <a
              href={sitePath(`/articles/${article.slug}/`)}
              data-cvr-action="home_latest_article_click"
              data-action-kind="safe"
              data-source-slug="home"
              data-slot-index={index + 1}
              data-item-id={article.slug}
            >
              <img src={sitePath(articleThumbnail(article))} alt="" width="96" height="54" loading="lazy" />
              <span>
                <time datetime={article.data.pubDate.toISOString()}>{shortDate.format(article.data.pubDate)}</time>
                <strong>{article.data.title}</strong>
              </span>
            </a>
          ))
        }
      </div>
      <a class="latest-articles-more" href={sitePath("/articles/")}>一覧</a>
    </div>
  </section>

  <section class="container section home-chat-section">
    <DiagnosisChat startClosed={false} showHeader={false} />
  </section>

  <section class="container section home-route-section" aria-labelledby="route-title">
    <div class="section-header">
      <div>
        <p class="eyebrow">目的別リンク</p>
        <h2 id="route-title">次に見るページを選ぶ</h2>
        <p>相談のあとに詳しく読むページを、悩み別にまとめました。気になる行を押すと、そのページへ移動します。</p>
      </div>
      <a href={sitePath("/articles/")}>記事一覧へ</a>
    </div>
    <div class="home-route-grid">
      {
        routeGroups.map((group) => (
          <article class="home-route-card">
            <div>
              <span>{group.label}</span>
              <h3>{group.title}</h3>
              <p>{group.body}</p>
            </div>
            <ul>
              {group.links.map((link) => (
                <li><a href={sitePath(link.href)}>{link.label}</a></li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
    <div class="home-route-footer">
      <div>
        <strong>まだ迷うときは、症状から相談できます。</strong>
        <span>使用停止・修理相談・買い替え比較のどれを先に見るか、チャットで絞ります。</span>
      </div>
      <a href="#chat-title" data-cvr-action="home_route_footer_chat_click" data-action-kind="safe">3分相談へ戻る</a>
    </div>
  </section>

  <script>
    document.addEventListener("click", (event) => {
      const targetEl = event.target instanceof Element ? event.target : event.target?.parentElement;
      const symptomTarget = targetEl?.closest("[data-diagnosis-symptom]");
      if (!symptomTarget) return;
      event.preventDefault();

      const label =
        symptomTarget.querySelector("strong")?.textContent?.trim() ??
        symptomTarget.textContent?.trim().replace(/\s+/g, " ");
      window.dispatchEvent(
        new CustomEvent("diagnosis:symptom", {
          detail: {
            symptomId: symptomTarget.dataset.diagnosisSymptom,
            label
          }
        })
      );
    });
  </script>
</BaseLayout>

<style>
  .latest-articles {
    border-block: 1px solid var(--paper-line);
    background: var(--paper);
  }

  .latest-articles-inner {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 14px;
    padding-block: 12px;
  }

  .latest-articles-heading {
    display: flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
  }

  .latest-articles-heading span {
    border-radius: 999px;
    padding: 2px 7px;
    background: var(--danger);
    color: white;
    font-size: 0.68rem;
    font-weight: 900;
    letter-spacing: 0.08em;
  }

  .latest-articles-heading h2 {
    margin: 0;
    font-size: 0.95rem;
  }

  .latest-articles-list {
    display: flex;
    gap: 8px;
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: thin;
  }

  .latest-articles-list > a {
    display: grid;
    grid-template-columns: 64px 1fr;
    flex: 0 0 min(250px, 76vw);
    align-items: center;
    gap: 8px;
    min-height: 58px;
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 5px;
    background: white;
    color: var(--ink);
    text-decoration: none;
  }

  .latest-articles-list > a:hover {
    border-color: var(--brand-line);
    background: var(--brand-soft);
  }

  .latest-articles-list img {
    width: 64px;
    height: 44px;
    border-radius: 5px;
    object-fit: cover;
  }

  .latest-articles-list a > span {
    display: grid;
    gap: 1px;
    min-width: 0;
  }

  .latest-articles-list time {
    color: var(--muted);
    font-size: 0.7rem;
    line-height: 1.2;
  }

  .latest-articles-list strong {
    display: -webkit-box;
    overflow: hidden;
    font-size: 0.78rem;
    line-height: 1.35;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .latest-articles-more {
    font-size: 0.8rem;
    font-weight: 800;
    white-space: nowrap;
  }

  @media (max-width: 760px) {
    .latest-articles-inner {
      grid-template-columns: 1fr auto;
    }

    .latest-articles-list {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }
</style>
