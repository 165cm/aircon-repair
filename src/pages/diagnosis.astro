---
import DiagnosisChat from "@components/DiagnosisChat.astro";
import EmergencyAlert from "@components/EmergencyAlert.astro";
import GlossaryBox from "@components/GlossaryBox.astro";
import RevenueCta from "@components/RevenueCta.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout
  title="症状を相談する"
  description="冷えない、水もれ、変な音、リモコン不調、カビ臭。症状を選ぶだけで、風見先生が自分で見ていい範囲と、修理を呼ぶ目安を整理します。"
  ogImage="/images/articles/basics-symptom-types.webp"
>
  <section class="container article-head">
    <p class="eyebrow">風見先生の3分問診</p>
    <h1>症状を相談する</h1>
    <p class="lead">直し方ではなく、「今どうするか」を決める相談です。あぶないサインから順番に見ていきます。</p>
  </section>

  <section class="container section">
    <DiagnosisChat showHeader={false} startClosed={false} />
  </section>

  <section class="container section">
    <EmergencyAlert />
  </section>

  <section class="container section">
    <GlossaryBox limit={6} />
  </section>

  <section class="container section">
    <RevenueCta variant="contractor" />
  </section>
</BaseLayout>
