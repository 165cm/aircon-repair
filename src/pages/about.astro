---
import BaseLayout from "@layouts/BaseLayout.astro";
import { sitePath } from "@utils/paths";

const profilePoints = [
  "家庭用エアコンの修理・点検現場で学んだ基礎知識を、一般家庭向けに噛み砕いて整理します。",
  "現場でよく聞く「冷えない」「水漏れ」「変な音」「掃除していい場所が分からない」を中心に扱います。",
  "記事は勉強用のメモを公開向けに整えたもので、個別機種の故障診断や修理指示ではありません。"
];

const editorialRules = [
  "危険な分解、電気工事、冷媒作業、基板修理、200Vまわりの作業は初心者向け手順として紹介しません。",
  "自分で確認できる範囲と、専門業者・資格者へ相談すべき範囲を記事内で分けます。",
  "メーカー公式、公的機関、販売ページ、仕様情報を確認し、価格・在庫・仕様はリンク先での再確認を促します。",
  "商品紹介では、価格を固定表示せず、用途・注意点・向いている症状を優先して説明します。"
];

const transparencyItems = [
  "Amazonアソシエイト、業者紹介、求人サービスなどの広告リンクを掲載する場合があります。",
  "広告収益はサイト運営、調査、画像作成、記事更新の費用に充てます。",
  "報酬の有無に関わらず、危険作業を促す商品や、初心者が誤って使いやすい商材はおすすめしません。"
];
---

<BaseLayout
  title="運営者・編集方針"
  description="エアコン難民レスキューの運営者情報、記事の作り方、安全方針、広告・アフィリエイト運用方針を掲載します。"
>
  <section class="container section">
    <p class="eyebrow">信頼性と安全方針</p>
    <h1>運営者・編集方針</h1>
    <p class="lead">このサイトは、エアコン修理エンジニアが勉強と知識整理のために作成している、一般家庭向けのエアコン不調ガイドです。できる確認と専門家へ任せる範囲を分けて案内します。</p>
  </section>

  <section class="container section">
    <div class="grid two">
      <div class="panel">
        <h2>運営者</h2>
        <p>エアコン難民レスキュー編集部。家庭用エアコン修理に関わるエンジニアが、日々の学習と復習を兼ねて、夏の不調、掃除・予防、修理/買い替え判断、関連商品の選び方を整理しています。</p>
        <ul class="check-list">
          {profilePoints.map((point) => <li>{point}</li>)}
        </ul>
      </div>
      <div class="panel">
        <h2>このサイトの目的</h2>
        <p>エアコンが壊れたかもしれない時に、読者が慌てて危険な作業へ進まないよう、まず安全な確認順を作ることを目的にしています。</p>
        <p>あわせて、修理を待つ間の暑さ対策、故障予防、買い替え判断、エアコン修理・クリーニング職への興味につながる学習導線も用意します。</p>
      </div>
    </div>
  </section>

  <section class="container section">
    <div class="panel">
      <p class="eyebrow">編集ルール</p>
      <h2>記事を作る時に守ること</h2>
      <ul class="check-list">
        {editorialRules.map((rule) => <li>{rule}</li>)}
      </ul>
    </div>
  </section>

  <section class="container section">
    <div class="grid two">
      <div class="panel">
        <p class="eyebrow">扱う範囲</p>
        <h2>自力確認として扱う内容</h2>
        <p>フィルター掃除、外装の拭き掃除、室外機まわりの整理、ドレンホース先端確認、リモコン切り分け、温湿度管理、畳数別の買い替え判断を扱います。</p>
      </div>
      <div class="panel">
        <p class="eyebrow">扱わない範囲</p>
        <h2>専門業者へ任せる内容</h2>
        <p>電気工事、冷媒充填・回収、基板修理、内部分解洗浄、高所作業、200Vまわりの判断は、専門業者・資格者へ相談する前提で案内します。</p>
      </div>
    </div>
  </section>

  <section class="container section">
    <div class="panel">
      <p class="eyebrow">広告と収益</p>
      <h2>アフィリエイト運用方針</h2>
      <ul class="check-list">
        {transparencyItems.map((item) => <li>{item}</li>)}
      </ul>
      <div class="button-row">
        <a class="button" href={sitePath("/disclaimer/")}>広告表記・免責事項を見る</a>
        <a class="button secondary" href={sitePath("/products/")}>商品比較を見る</a>
      </div>
    </div>
  </section>

  <section class="container section">
    <div class="notice">
      当サイトは学習・情報整理を目的とした一般向けコンテンツです。メーカーや販売店、工事業者の公式判断に代わるものではありません。危険サインがある場合や判断に迷う場合は、使用を中止して専門業者へ相談してください。
    </div>
  </section>
</BaseLayout>
