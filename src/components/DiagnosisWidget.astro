---
import { getCollection } from "astro:content";
import { diagnosisItems } from "@data/diagnosis";
import { productCategories } from "@data/products";

const first = diagnosisItems[0];
const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
const articles = await getCollection("articles");
const articleTitleBySlug = Object.fromEntries(
  articles.map((article) => [article.slug, article.data.title])
);
const urgencyLabel = {
  low: "落ち着いて切り分け",
  medium: "早めに確認",
  high: "使用停止も検討"
};
const decisionModes = [
  {
    id: "repair",
    label: "年式が浅い・症状は1つ",
    hint: "修理相談を優先"
  },
  {
    id: "replacement",
    label: "10年以上・症状が重なる",
    hint: "買い替え比較も開始"
  },
  {
    id: "urgent",
    label: "焦げ臭い・煙・電源まわりの水",
    hint: "使用停止して相談"
  }
];
const firstSections = [
  {
    eyebrow: urgencyLabel[first.urgency],
    title: "安全にできる確認",
    items: first.safeChecks
  },
  {
    eyebrow: "ここから先は無理しない",
    title: "専門相談のサイン",
    items: first.stopSigns
  }
];
const firstCostDecision = {
  repairSignals: first.repairSignals,
  replacementSignals: first.replacementSignals,
  cta: {
    href: `${basePath}/by-size/`,
    label: "買い替え候補を見る"
  }
};
---

<section class="panel" aria-labelledby="diagnosis-title">
  <p class="eyebrow">3分診断</p>
  <h2 id="diagnosis-title">症状と状況を選ぶだけで、次の行動を決める</h2>
  <p class="diagnosis-intro">危険な分解には進まず、記事内の判断基準に沿って「修理相談」「買い替え比較」「使用停止」を出し分けます。</p>
  <ol class="diagnosis-progress" aria-label="診断の流れ">
    <li><span>1</span>症状</li>
    <li><span>2</span>状況</li>
    <li><span>3</span>次の行動</li>
  </ol>
  <div class="diagnosis-tabs" role="tablist" aria-label="症状">
    {
      diagnosisItems.map((item) => (
        <button
          class="diagnosis-tab"
          type="button"
          role="tab"
          aria-selected={item.id === first.id ? "true" : "false"}
          data-diagnosis-tab={item.id}
          data-cvr-action="diagnosis_tab_click"
          data-action-kind="safe"
          aria-label={item.label}
        >
          {item.tabLabel}
        </button>
      ))
    }
  </div>
  <div id="diagnosis-recommendation" class="diagnosis-recommendation" aria-live="polite"></div>
  <div class="diagnosis-mode-group" role="radiogroup" aria-label="使用年数や危険サイン">
    {
      decisionModes.map((mode, index) => (
        <button
          class="diagnosis-mode"
          type="button"
          role="radio"
          aria-checked={index === 0 ? "true" : "false"}
          data-decision-mode={mode.id}
        >
          <strong>{mode.label}</strong>
          <small>{mode.hint}</small>
        </button>
      ))
    }
  </div>
  <div id="diagnosis-result" class="diagnosis-result" aria-live="polite">
    {
      firstSections.map((section) => (
        <details class="diagnosis-accordion">
          <summary>
            <span class="eyebrow">{section.eyebrow}</span>
            <span class="diagnosis-summary-title">{section.title}</span>
          </summary>
          <ul class="diagnosis-check-list">{section.items.map((item) => <li>{item}</li>)}</ul>
          {section.cta && (
            <a class="button warm" href={section.cta.href} data-cvr-action="diagnosis_replacement_click" data-action-kind="replacement">{section.cta.label}</a>
          )}
        </details>
      ))
    }
    <details class="diagnosis-accordion decision-accordion">
      <summary>
        <span class="eyebrow">費用判断</span>
        <span class="diagnosis-summary-title">修理か買い替えかを比べる</span>
      </summary>
      <div class="diagnosis-decision-table" role="table" aria-label="修理と買い替えの判断基準">
        <div class="decision-column" role="row">
          <h3>修理が向きやすい</h3>
          <ul class="diagnosis-check-list">{firstCostDecision.repairSignals.map((item) => <li>{item}</li>)}</ul>
        </div>
        <div class="decision-column replacement" role="row">
          <h3>買い替えも比較する</h3>
          <ul class="diagnosis-check-list">{firstCostDecision.replacementSignals.map((item) => <li>{item}</li>)}</ul>
        </div>
      </div>
      <a class="button warm" href={firstCostDecision.cta.href} data-cvr-action="diagnosis_replacement_click" data-action-kind="replacement">{firstCostDecision.cta.label}</a>
    </details>
  </div>
</section>

<script define:vars={{ diagnosisItems, productCategories, basePath, articleTitleBySlug }}>
  const result = document.querySelector("#diagnosis-result");
  const recommendation = document.querySelector("#diagnosis-recommendation");
  const tabs = Array.from(document.querySelectorAll("[data-diagnosis-tab]"));
  const modeButtons = Array.from(document.querySelectorAll("[data-decision-mode]"));
  let currentMode = "repair";

  function productDisplayName(product) {
    const generalNames = {
      "thermo-hygrometer": "温湿度計",
      "filter-brush": "エアコンブラシ",
      "drain-pump": "ドレンホースクリーナー",
      "outdoor-cover": "室外機カバー",
      "circulator": "サーキュレーター",
      "remote-battery": "汎用リモコン",
      "aircon-6tatami": "6畳用エアコン",
      "aircon-8tatami": "8畳用エアコン",
      "aircon-10tatami": "10畳用エアコン",
      "aircon-14tatami": "14畳用エアコン",
      "aircon-18tatami": "18畳以上のエアコン"
    };

    if (generalNames[product.id]) return generalNames[product.id];
    return product.brand ? product.name.replace(product.brand, "").trim() : product.name;
  }

  function recommendationCopy(item, mode) {
    if (mode === "urgent") {
      return {
        tone: "danger",
        eyebrow: "推奨: 使用停止して専門相談",
        title: "焦げ臭さ・煙・電源まわりの水は、修理判断の前に止める",
        body: "安全確認は外側の観察とメモまで。ブレーカーが落ちる、火花、金属音が続く場合も同じ扱いです。",
        primaryHref: `${basePath}/articles/call-contractor/`,
        primaryLabel: "業者へ相談する目安を見る",
        primaryKind: "contractor",
        secondaryHref: `${basePath}/diagnosis/#danger-signs`,
        secondaryLabel: "危険サインを確認"
      };
    }

    if (mode === "replacement") {
      return {
        tone: "replacement",
        eyebrow: "推奨: 買い替え比較も同時に進める",
        title: "10年以上・複数症状・高めの見積もりなら新品候補を先に比較",
        body: "修理を否定せず、畳数に合う本体と工事込みの総額を見てから判断すると迷いにくくなります。",
        primaryHref: `${basePath}/by-size/`,
        primaryLabel: "畳数で買い替え比較",
        primaryKind: "replacement",
        secondaryHref: `${basePath}/articles/installation-cost/`,
        secondaryLabel: "工事費の目安を見る"
      };
    }

    return {
      tone: "repair",
      eyebrow: "推奨: 修理相談を優先",
      title: "年式が浅く症状が1つなら、原因をメモして修理相談へ",
      body: `${item.label}は、外側の安全確認とエラー・音・水の出方をメモすると相談が早くなります。`,
      primaryHref: `${basePath}/articles/call-contractor/`,
      primaryLabel: "修理を呼ぶ目安を見る",
      primaryKind: "contractor",
      secondaryHref: `${basePath}/articles/${item.articleSlugs[0]}/`,
      secondaryLabel: "症状別の記事を読む"
    };
  }

  function renderDiagnosis(id) {
    const item = diagnosisItems.find((entry) => entry.id === id) ?? diagnosisItems[0];
    const products = productCategories.filter((product) => item.productIds.includes(product.id));
    const urgency = {
      low: "落ち着いて切り分け",
      medium: "早めに確認",
      high: "使用停止も検討"
    }[item.urgency];
    const sections = [
      {
        eyebrow: urgency,
        title: "安全にできる確認",
        items: item.safeChecks
      },
      {
        eyebrow: "ここから先は無理しない",
        title: "専門相談のサイン",
        items: item.stopSigns
      }
    ];
    const costDecision = {
      repairSignals: item.repairSignals,
      replacementSignals: item.replacementSignals,
      cta: {
        href: `${basePath}/by-size/`,
        label: "買い替え候補を見る"
      }
    };
    const next = recommendationCopy(item, currentMode);

    recommendation.innerHTML = `
      <div class="diagnosis-recommendation-card ${next.tone}">
        <div>
          <p class="eyebrow">${next.eyebrow}</p>
          <h3>${next.title}</h3>
          <p>${next.body}</p>
        </div>
        <div class="diagnosis-recommendation-actions">
          <a class="button ${next.tone === "replacement" ? "warm" : ""}" href="${next.primaryHref}" data-cvr-action="diagnosis_next_action_click" data-action-kind="${next.primaryKind}">${next.primaryLabel}</a>
          <a class="button secondary" href="${next.secondaryHref}" data-cvr-action="diagnosis_secondary_action_click" data-action-kind="safe">${next.secondaryLabel}</a>
        </div>
      </div>
    `;
    result.innerHTML = `
      ${sections.map((section) => `
        <details class="diagnosis-accordion">
          <summary>
            <span class="eyebrow">${section.eyebrow}</span>
            <span class="diagnosis-summary-title">${section.title}</span>
          </summary>
          <ul class="diagnosis-check-list">${section.items.map((entry) => `<li>${entry}</li>`).join("")}</ul>
        </details>
      `).join("")}
      <details class="diagnosis-accordion decision-accordion">
        <summary>
          <span class="eyebrow">費用判断</span>
          <span class="diagnosis-summary-title">修理か買い替えかを比べる</span>
        </summary>
        <div class="diagnosis-decision-table" role="table" aria-label="修理と買い替えの判断基準">
          <div class="decision-column" role="row">
            <h3>修理が向きやすい</h3>
            <ul class="diagnosis-check-list">${costDecision.repairSignals.map((entry) => `<li>${entry}</li>`).join("")}</ul>
          </div>
          <div class="decision-column replacement" role="row">
            <h3>買い替えも比較する</h3>
            <ul class="diagnosis-check-list">${costDecision.replacementSignals.map((entry) => `<li>${entry}</li>`).join("")}</ul>
          </div>
        </div>
        <a class="button warm" href="${costDecision.cta.href}" data-cvr-action="diagnosis_replacement_click" data-action-kind="replacement">${costDecision.cta.label}</a>
      </details>
      <div class="card">
        <h3>関連する商品</h3>
        <ul>${products.map((product) => `<li><a href="${basePath}/products/${product.id}/">${productDisplayName(product)}</a></li>`).join("")}</ul>
        <a class="button" href="${basePath}/products/" data-cvr-action="diagnosis_products_click" data-action-kind="products">商品カテゴリを見る</a>
      </div>
      <div class="card">
        <h3>詳しく読む</h3>
        <ul>${item.articleSlugs.map((slug) => `<li><a href="${basePath}/articles/${slug}/">${articleTitleBySlug[slug] ?? slug}</a></li>`).join("")}</ul>
        <a class="button secondary" href="${basePath}/diagnosis/#${item.id}" data-cvr-action="diagnosis_detail_click" data-action-kind="safe">診断ページへ</a>
      </div>
    `;

    tabs.forEach((tab) => {
      tab.setAttribute("aria-selected", tab.dataset.diagnosisTab === item.id ? "true" : "false");
    });
  }

  tabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      renderDiagnosis(tab.dataset.diagnosisTab);
      if (tab.dataset.diagnosisTab) {
        history.replaceState(null, "", `#${tab.dataset.diagnosisTab}`);
      }
    });
  });

  modeButtons.forEach((button) => {
    button.addEventListener("click", () => {
      currentMode = button.dataset.decisionMode ?? "repair";
      modeButtons.forEach((entry) => {
        entry.setAttribute("aria-checked", entry === button ? "true" : "false");
      });
      const selectedId = tabs.find((tab) => tab.getAttribute("aria-selected") === "true")?.dataset.diagnosisTab;
      renderDiagnosis(selectedId ?? diagnosisItems[0].id);
    });
  });

  const initialId = location.hash.replace("#", "");
  renderDiagnosis(diagnosisItems.some((item) => item.id === initialId) ? initialId : diagnosisItems[0].id);

  window.addEventListener("hashchange", () => {
    const hashId = location.hash.replace("#", "");
    if (diagnosisItems.some((item) => item.id === hashId)) {
      renderDiagnosis(hashId);
    }
  });
</script>
