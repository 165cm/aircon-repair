---
import { diagnosisItems } from "@data/diagnosis";
import { productCategories } from "@data/products";

const first = diagnosisItems[0];
const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<section class="panel" aria-labelledby="diagnosis-title">
  <p class="eyebrow">症状別セルフチェック</p>
  <h2 id="diagnosis-title">いまの症状を選んで、安全な確認だけを見る</h2>
  <div class="diagnosis-tabs" role="tablist" aria-label="症状">
    {
      diagnosisItems.map((item) => (
        <button
          class="diagnosis-tab"
          type="button"
          role="tab"
          aria-selected={item.id === first.id ? "true" : "false"}
          data-diagnosis-tab={item.id}
        >
          {item.label}
        </button>
      ))
    }
  </div>
  <div id="diagnosis-result" class="diagnosis-result" aria-live="polite"></div>
</section>

<script define:vars={{ diagnosisItems, productCategories, basePath }}>
  const result = document.querySelector("#diagnosis-result");
  const tabs = Array.from(document.querySelectorAll("[data-diagnosis-tab]"));

  function renderDiagnosis(id) {
    const item = diagnosisItems.find((entry) => entry.id === id) ?? diagnosisItems[0];
    const products = productCategories.filter((product) => item.productIds.includes(product.id));
    const urgency = {
      low: "落ち着いて切り分け",
      medium: "早めに確認",
      high: "使用停止も検討"
    }[item.urgency];

    result.innerHTML = `
      <div class="card">
        <p class="eyebrow">${urgency}</p>
        <h3>安全にできる確認</h3>
        <ul>${item.safeChecks.map((check) => `<li>${check}</li>`).join("")}</ul>
      </div>
      <div class="card">
        <p class="eyebrow">ここから先は無理しない</p>
        <h3>専門相談のサイン</h3>
        <ul>${item.stopSigns.map((sign) => `<li>${sign}</li>`).join("")}</ul>
      </div>
      <div class="card">
        <p class="eyebrow">費用判断</p>
        <h3>修理が向きやすいケース</h3>
        <ul>${item.repairSignals.map((signal) => `<li>${signal}</li>`).join("")}</ul>
      </div>
      <div class="card">
        <p class="eyebrow">買い替え検討</p>
        <h3>新品比較へ進む目安</h3>
        <ul>${item.replacementSignals.map((signal) => `<li>${signal}</li>`).join("")}</ul>
        <a class="button warm" href="${basePath}/products/#replacement">買い替え候補を見る</a>
      </div>
      <div class="card">
        <h3>関連する商品</h3>
        <ul>${products.map((product) => `<li>${product.name}</li>`).join("")}</ul>
        <a class="button" href="${basePath}/products/">商品カテゴリを見る</a>
      </div>
      <div class="card">
        <h3>詳しく読む</h3>
        <ul>${item.articleSlugs.map((slug) => `<li><a href="${basePath}/articles/${slug}/">${slug}</a></li>`).join("")}</ul>
        <a class="button secondary" href="${basePath}/diagnosis/">診断ページへ</a>
      </div>
    `;

    tabs.forEach((tab) => {
      tab.setAttribute("aria-selected", tab.dataset.diagnosisTab === item.id ? "true" : "false");
    });
  }

  tabs.forEach((tab) => {
    tab.addEventListener("click", () => renderDiagnosis(tab.dataset.diagnosisTab));
  });

  renderDiagnosis(diagnosisItems[0].id);
</script>
