---
import { affiliate } from "@data/affiliate";
import { sitePath } from "@utils/paths";

type Props = {
  variant?: "contractor" | "jobs" | "products" | "replacement";
};

const { variant = "contractor" } = Astro.props;

const copy = {
  contractor: {
    title: "危険サインがある時は、専門業者へ",
    body: "内部洗浄、冷媒、電気配線、分解修理は自己判断で触らず、症状メモを用意して相談しましょう。",
    href: affiliate.contractorAffiliateUrl,
    label: "業者相談の候補を見る",
    action: "contractor_consult_click",
    kind: "contractor"
  },
  jobs: {
    title: "エアコン修理・清掃の仕事に興味が出たら",
    body: "繁忙期は空調設備、修理補助、クリーニングスタッフの求人が増えます。未経験可の募集から現場を知る道もあります。",
    href: affiliate.jobAffiliateUrl,
    label: "求人サイトの候補を見る",
    action: "job_site_click",
    kind: "products"
  },
  products: {
    title: "安全に使える補助用品から整える",
    body: "分解修理ではなく、温湿度計、フィルター掃除、室外機まわり整理などの安全な範囲から始めましょう。",
    href: "/products/",
    label: "商品カテゴリを見る",
    action: "support_products_click",
    kind: "products"
  },
  replacement: {
    title: "10年以上・高額修理なら買い替えも比較",
    body: "修理費が新品本体の半額前後になる時は、畳数・標準工事・電源条件を先に確認して判断を速くしましょう。",
    href: "/by-size/",
    label: "畳数で買い替え候補を見る",
    action: "replacement_compare_click",
    kind: "replacement"
  }
}[variant];
---

<aside class="panel revenue-cta">
  <h2>{copy.title}</h2>
  <p>{copy.body}</p>
  <a
    class={`button revenue-cta-btn ${variant === "jobs" || variant === "replacement" ? "warm" : ""}`}
    href={sitePath(copy.href)}
    rel={copy.href.startsWith("http") ? "sponsored nofollow noopener" : undefined}
    target={copy.href.startsWith("http") ? "_blank" : undefined}
    data-cvr-action={copy.action}
    data-action-kind={copy.kind}
  >
    {copy.label}
  </a>
</aside>

<style>
.revenue-cta {
  border-left: 4px solid var(--brand);
}
.revenue-cta-btn {
  width: 100%;
  margin-top: 8px;
}
</style>
