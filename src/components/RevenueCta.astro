---
import { affiliate } from "@data/affiliate";
import { sitePath } from "@utils/paths";

type Props = {
  variant?: "contractor" | "jobs" | "products" | "replacement";
};

const { variant = "contractor" } = Astro.props;

const copy = {
  contractor: {
    title: "ここから先は、プロの出番です",
    body: "内部の洗浄、冷媒、電気配線、分解修理は自分で触らないでください。症状メモを用意して相談しましょう。",
    href: affiliate.contractorAffiliateUrl,
    label: "業者相談の候補を見る",
    action: "contractor_consult_click",
    kind: "contractor"
  },
  jobs: {
    title: "この仕事、気になりましたか",
    body: "夏の忙しい時期は、修理の補助やクリーニングの募集が増えます。未経験からでも現場を知る道はあります。",
    href: affiliate.jobAffiliateUrl,
    label: "求人サイトの候補を見る",
    action: "job_site_click",
    kind: "products"
  },
  products: {
    title: "道具でできることから",
    body: "分解はしません。温湿度計、フィルター掃除、室外機まわりの整理など、安全な範囲から始めましょう。",
    href: "/products/",
    label: "商品カテゴリを見る",
    action: "support_products_click",
    kind: "products"
  },
  replacement: {
    title: "10年以上・修理費が高いなら",
    body: "修理費が新品の半額くらいになるなら、畳数・標準工事・電源の条件を先に見ておくと決めやすくなります。",
    href: "/by-size/",
    label: "畳数で買い替え候補を見る",
    action: "replacement_compare_click",
    kind: "replacement"
  }
}[variant];
---

<aside class="panel revenue-cta">
  <h2>{copy.title}</h2>
  <p>{copy.body}</p>
  <a
    class={`button revenue-cta-btn ${variant === "jobs" || variant === "replacement" ? "warm" : ""}`}
    href={sitePath(copy.href)}
    rel={copy.href.startsWith("http") ? "sponsored nofollow noopener" : undefined}
    target={copy.href.startsWith("http") ? "_blank" : undefined}
    data-cvr-action={copy.action}
    data-action-kind={copy.kind}
  >
    {copy.label}
  </a>
</aside>

<style>
.revenue-cta {
  border-left: 4px solid var(--brand);
}
.revenue-cta-btn {
  width: 100%;
  margin-top: 8px;
}
</style>
