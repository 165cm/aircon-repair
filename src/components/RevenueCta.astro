---
import { affiliate } from "@data/affiliate";

type Props = {
  variant?: "contractor" | "jobs" | "products";
};

const { variant = "contractor" } = Astro.props;

const copy = {
  contractor: {
    title: "危険サインがある時は、専門業者へ",
    body: "内部洗浄、冷媒、電気配線、分解修理は自己判断で触らず、症状メモを用意して相談しましょう。",
    href: affiliate.contractorAffiliateUrl,
    label: "業者相談の候補を見る"
  },
  jobs: {
    title: "エアコン修理・清掃の仕事に興味が出たら",
    body: "繁忙期は空調設備、修理補助、クリーニングスタッフの求人が増えます。未経験可の募集から現場を知る道もあります。",
    href: affiliate.jobAffiliateUrl,
    label: "求人サイトの候補を見る"
  },
  products: {
    title: "安全に使える補助用品から整える",
    body: "分解修理ではなく、温湿度計、フィルター掃除、室外機まわり整理などの安全な範囲から始めましょう。",
    href: "/products/",
    label: "商品カテゴリを見る"
  }
}[variant];
---

<aside class="panel">
  <h2>{copy.title}</h2>
  <p>{copy.body}</p>
  <a class={`button ${variant === "jobs" ? "warm" : ""}`} href={copy.href} rel={copy.href.startsWith("http") ? "sponsored nofollow noopener" : undefined} target={copy.href.startsWith("http") ? "_blank" : undefined}>
    {copy.label}
  </a>
</aside>
