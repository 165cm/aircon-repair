---
// compact: 記事本文用。見出しだけ出して、サインの一覧は開いたときに見せる。
// 通常: トップや診断ページ用。最初から全部見せる。
type Props = { compact?: boolean };
const { compact = false } = Astro.props;

const signs = [
  "焦げ臭い・煙・火花",
  "ブレーカーが繰り返し落ちる",
  "電源やコンセント付近に水がある",
  "異常に大きな振動や金属音"
];
---

{
  compact ? (
    <details class="emergency-alert emergency-alert-compact" id="danger-signs">
      <summary>
        <span class="emergency-alert-icon" aria-hidden="true">!</span>
        <span>
          <strong>次のときは、確認より先に運転を止めてください</strong>
          <small>4つのサインを見る</small>
        </span>
      </summary>
      <ul>{signs.map((sign) => <li>{sign}</li>)}</ul>
    </details>
  ) : (
    <aside class="emergency-alert" id="danger-signs" aria-labelledby="emergency-alert-title">
      <div class="emergency-alert-icon" aria-hidden="true">!</div>
      <div>
        <p class="eyebrow">使用停止のサイン</p>
        <h2 id="emergency-alert-title">次の症状があるときは、確認を続けず運転を止めてください</h2>
        <ul>{signs.map((sign) => <li>{sign}</li>)}</ul>
      </div>
    </aside>
  )
}

<script>
  document.querySelectorAll<HTMLElement>(".emergency-alert").forEach((alert) => {
    if (alert.dataset.trackingReady) return;
    alert.dataset.trackingReady = "true";
    const observer = new IntersectionObserver((entries) => {
      if (!entries.some((entry) => entry.isIntersecting)) return;
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ event: "emergency_alert_view" });
      observer.disconnect();
    }, { threshold: 0.5 });
    observer.observe(alert);
  });
</script>
