---
import ProductCard from "./ProductCard.astro";
import { productCategories, type ProductCategory } from "@data/products";

type Props = {
  products?: ProductCategory[];
  pageType?: string;
  linkPosition?: string;
  variant?: "default" | "comparison" | "curation";
};

const { products = productCategories, pageType = "product-grid", linkPosition = "grid", variant = "default" } = Astro.props;
---

<div class:list={["grid", variant === "comparison" && "comparison-product-grid"]}>
  {products.map((product) => <ProductCard product={product} pageType={pageType} linkPosition={linkPosition} variant={variant} />)}
</div>
