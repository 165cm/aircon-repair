---
import ProductCard from "./ProductCard.astro";
import { productCategories, type ProductCategory } from "@data/products";

type Props = {
  products?: ProductCategory[];
  pageType?: string;
  linkPosition?: string;
};

const { products = productCategories, pageType = "product-grid", linkPosition = "grid" } = Astro.props;
---

<div class="grid">
  {products.map((product) => <ProductCard product={product} pageType={pageType} linkPosition={linkPosition} />)}
</div>
