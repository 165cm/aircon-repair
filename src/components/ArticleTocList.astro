---
import type { CollectionEntry } from "astro:content";
import { articleThumbnail } from "@utils/articles";
import { sitePath } from "@utils/paths";

type Props = {
  articles: CollectionEntry<"articles">[];
};

const { articles } = Astro.props;
---

<ol class="article-table-list">
  {
    articles.map((article, index) => (
      <li>
        <a class="article-table-row" href={sitePath(`/articles/${article.slug}/`)}>
          <span class="article-table-number">{String(index + 1).padStart(2, "0")}</span>
          <img src={sitePath(articleThumbnail(article))} alt="" loading="lazy" />
          <span class="article-table-copy">
            <strong>{article.data.title}</strong>
            <span>{article.data.description}</span>
          </span>
        </a>
      </li>
    ))
  }
</ol>
