---
import { productUrl, type ProductCategory } from "@data/products";

type Props = {
  product: ProductCategory;
  label?: string;
  pageType?: string;
  linkPosition?: string;
  variant?: "button" | "inline";
  sourceSlug?: string;
  slotIndex?: number;
  recommendationRole?: string;
};

const {
  product,
  label = "Amazonの商品ページを見る",
  pageType = "unknown",
  linkPosition = "inline",
  variant = "button",
  sourceSlug,
  slotIndex,
  recommendationRole
} = Astro.props;
---

<a
  class={variant === "button" ? "button" : "inline-link"}
  href={productUrl(product)}
  rel="sponsored nofollow noopener"
  target="_blank"
  data-amazon-link
  data-cvr-action={product.type === "replacement" ? "amazon_replacement_click" : "amazon_support_click"}
  data-action-kind={product.type === "replacement" ? "replacement" : "products"}
  data-item-id={product.id}
  data-item-name={product.name}
  data-page-type={pageType}
  data-link-position={linkPosition}
  data-source-slug={sourceSlug}
  data-slot-index={slotIndex}
  data-recommendation-role={recommendationRole}
>
  {label}
</a>

<script is:inline>
  if (!window.__airconAmazonTrackingReady) {
    window.__airconAmazonTrackingReady = true;
    document.addEventListener("click", (event) => {
      const target = event.target instanceof Element ? event.target.closest("[data-amazon-link]") : null;
      if (!target) return;

      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({
        event: "outbound_click_amazon",
        item_id: target.getAttribute("data-item-id"),
        item_name: target.getAttribute("data-item-name"),
        page_type: target.getAttribute("data-page-type"),
        link_position: target.getAttribute("data-link-position"),
        source_slug: target.getAttribute("data-source-slug"),
        slot_index: target.getAttribute("data-slot-index"),
        recommendation_role: target.getAttribute("data-recommendation-role")
      });
    });
  }
</script>
