---
import { getCollection } from "astro:content";
import { diagnosisChat, farewells, symptomGuides } from "@data/diagnosisChat";
import { diagnosisItems } from "@data/diagnosis";
import { teachers } from "@data/teachers";
import { productCategories, productUrl } from "@data/products";
import { affiliate } from "@data/affiliate";
import { sitePath } from "@utils/paths";

const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");

const articles = await getCollection("articles");
const articleTitleBySlug = Object.fromEntries(articles.map((a) => [a.slug, a.data.title]));

// 症状ごとのチェックリスト（diagnosis.ts を流用、文章を二重化しない）
const symptomData = Object.fromEntries(
  diagnosisItems.map((item) => [
    item.id,
    {
      safeChecks: item.safeChecks,
      stopSigns: item.stopSigns,
      repairSignals: item.repairSignals,
      replacementSignals: item.replacementSignals
    }
  ])
);

// 風見先生（名前・立ち絵・丸アイコンの顔抜き位置）
const teacherAvatarFocus = {
  "netsugashi-reitaro": { x: "50%", y: "50%", scale: "1" },
  "tomuro-mamoru": { x: "50%", y: "50%", scale: "1" },
  "kazetooshi-kiyoshi": { x: "50%", y: "50%", scale: "1" },
  "mizumichi-nukeru": { x: "50%", y: "50%", scale: "1" },
  "kaikae-shinji": { x: "50%", y: "50%", scale: "1" },
  "genba-minoru": { x: "50%", y: "50%", scale: "1" }
};
const teacherData = Object.fromEntries(
  Object.values(teachers).map((t) => [t.id, { name: t.name, image: sitePath(t.avatarImage ?? t.image), avatar: teacherAvatarFocus[t.id] }])
);

// 商品（名前・Amazon URL・種別）
const productData = Object.fromEntries(
  productCategories.map((p) => [p.id, { name: p.name, url: productUrl(p), type: p.type ?? "support" }])
);

const affiliateUrls = {
  contractor: affiliate.contractorAffiliateUrl,
  cleaning: affiliate.cleaningAffiliateUrl
};

type Props = { compact?: boolean; startClosed?: boolean; showHeader?: boolean };
const { compact = false, startClosed = !compact, showHeader = true } = Astro.props;
const chatDomId = compact ? "diagnosis-chat-compact" : "diagnosis-chat-inline";
const resultStampImage = sitePath("/images/kazami/kazami-ok-stamp-v1.webp");
---

<section
  id={chatDomId}
  class={compact ? "chat chat-compact" : "panel chat"}
  aria-labelledby={compact ? undefined : "chat-title"}
  data-diagnosis-chat
  data-chat-start-closed={startClosed ? "true" : "false"}
>
  {
    !compact && showHeader ? (
      <>
        <p class="eyebrow">風見先生の3分問診</p>
        <h2 id="chat-title">風見先生と、次の行動を決める</h2>
        <p class="chat-intro">危険な分解には進みません。症状を選ぶだけで、安全確認、修理相談、買い替え検討の順に整理します。</p>
      </>
    ) : (
      !compact && <h2 id="chat-title" class="sr-only">症状を選んで相談する</h2>
    )
  }

  {!compact && startClosed && (
    <div class="chat-launch" data-chat-launch-panel>
      <p>質問は4ステップだけです。危険サイン、外側確認、修理相談、買い替え検討の順に見ます。</p>
      <button type="button" class="button" data-chat-launch data-cvr-action="diagnosis_chat_launch_click" data-action-kind="safe">
        症状を相談する
      </button>
    </div>
  )}

  <div class="chat-window" hidden={startClosed && !compact}>
    <div class="chat-log" role="log" aria-live="polite" aria-label="風見先生との会話">
      <!-- あいさつはJS無効時のフォールバック兼ビュー用にサーバー描画 -->
      <noscript>
        <div class="chat-row instructor">
          <div class="chat-bubble">
            このチャット診断はJavaScriptで動きます。症状別の確認は<a href={sitePath("/articles/")}>記事一覧</a>からもご覧いただけます。
          </div>
        </div>
      </noscript>
    </div>
    <div class="chat-replies" role="group" aria-label="返信を選ぶ"></div>
  </div>

  <div class="chat-controls" hidden={startClosed && !compact}>
    <button type="button" class="chat-control" data-chat-back hidden>← ひとつ戻る</button>
    <button type="button" class="chat-control" data-chat-restart hidden>最初から</button>
  </div>
</section>

<script define:vars={{ script: diagnosisChat, farewells, symptomGuides, symptomData, teacherData, productData, affiliateUrls, articleTitleBySlug, basePath, chatDomId, isCompact: compact, resultStampImage }}>
  const rootEl = document.getElementById(chatDomId);
  const logEl = rootEl?.querySelector(".chat-log");
  const repliesEl = rootEl?.querySelector(".chat-replies");
  const backBtn = rootEl?.querySelector("[data-chat-back]");
  const restartBtn = rootEl?.querySelector("[data-chat-restart]");
  const launchPanel = rootEl?.querySelector("[data-chat-launch-panel]");
  const launchBtn = rootEl?.querySelector("[data-chat-launch]");
  const windowEl = rootEl?.querySelector(".chat-window");
  const controlsEl = rootEl?.querySelector(".chat-controls");
  if (!rootEl || !logEl || !repliesEl || !backBtn || !restartBtn || !windowEl || !controlsEl) {
    throw new Error("DiagnosisChat: elements missing");
  }

  const state = { currentId: script.startNodeId, history: [] };
  const stepEls = [];
  const echoEls = [];
  let userInteracted = false;
  let isAnimating = false;
  let hasStarted = false;
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  function esc(value) {
    return String(value).replace(/[&<>"']/g, (c) =>
      ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]
    );
  }

  function pick(items) {
    return items[Math.floor(Math.random() * items.length)];
  }

  // 朝・昼・夜で、風見先生らしい落ち着いたあいさつに変える
  function timeGreetingText() {
    const hour = new Date().getHours();
    if (hour >= 5 && hour < 11) return "おはようございます。エアコン保健室の案内役、風見です。";
    if (hour >= 11 && hour < 18) return "こんにちは。エアコン保健室の案内役、風見です。";
    return "こんばんは。エアコン保健室の案内役、風見です。遅い時間ですので、安全を優先して確認しましょう。";
  }

  // InstructorMessage[] -> {html, isList}[] （1メッセージ1吹き出し）
  function messagesToBubbles(node) {
    return node.messages
      .map((m) => {
        if (m.timeGreeting) return { html: `<p>${esc(timeGreetingText())}</p>`, isList: false };
        if (m.variants) return { html: `<p>${esc(pick(m.variants))}</p>`, isList: false };
        if (m.text) return { html: `<p>${esc(m.text)}</p>`, isList: false };
        if (m.fromItem && node.symptom) {
          const items = symptomData[node.symptom]?.[m.fromItem.field] ?? [];
          if (!items.length) return null;
          const html = items.map((i) => `<p class="check-item">${esc(i)}</p>`).join("");
          return { html, isList: true };
        }
        return null;
      })
      .filter(Boolean);
  }

  function teacherHeaderHTML(teacherId) {
    const t = teacherData[teacherId];
    if (!t) return "";
    const shortName = t.name.split(/\s/)[0] + "先生";
    const avatar = t.avatar ?? { x: "50%", y: "50%", scale: "1" };
    return `
      <div class="chat-avatar-wrap">
        <span class="chat-avatar-frame">
          <img
            src="${esc(t.image)}"
            alt="${esc(t.name)}先生の顔"
            loading="lazy"
            width="88"
            height="88"
            style="--avatar-x: ${esc(avatar.x)}; --avatar-y: ${esc(avatar.y)}; --avatar-scale: ${esc(avatar.scale)};"
          />
        </span>
        <span class="chat-avatar-name">${esc(shortName)}</span>
      </div>`;
  }

  function actionToAnchorHTML(action) {
    if (action.type === "product") {
      const p = productData[action.productId];
      if (!p) return "";
      const isReplacement = p.type === "replacement";
      const cvr = isReplacement ? "amazon_replacement_click" : "amazon_support_click";
      const kind = isReplacement ? "replacement" : "products";
      const label = isReplacement ? `${p.name}を比較する` : `${p.name}を見る`;
      const cls = isReplacement ? "button warm" : "button";
      return `<a class="${cls}" href="${esc(p.url)}" rel="sponsored nofollow noopener" target="_blank"
        data-amazon-link data-cvr-action="${cvr}" data-action-kind="${kind}"
        data-item-id="${esc(action.productId)}" data-item-name="${esc(p.name)}"
        data-page-type="diagnosis-chat" data-link-position="chat-terminal"
        data-recommendation-role="${esc(action.role ?? "")}">${esc(label)}<span class="sr-only">（新しいタブで開きます）</span></a>`;
    }
    if (action.type === "contractor") {
      return `<a class="button" href="${esc(affiliateUrls.contractor)}" rel="sponsored nofollow noopener" target="_blank"
        data-cvr-action="contractor_consult_click" data-action-kind="contractor">業者に相談する<span class="sr-only">（新しいタブで開きます）</span></a>`;
    }
    if (action.type === "cleaning") {
      return `<a class="button" href="${esc(affiliateUrls.cleaning)}" rel="sponsored nofollow noopener" target="_blank"
        data-cvr-action="cleaning_consult_click" data-action-kind="contractor">分解クリーニングを相談する<span class="sr-only">（新しいタブで開きます）</span></a>`;
    }
    if (action.type === "replacement") {
      return `<a class="button warm" href="${esc(basePath)}/by-size/"
        data-cvr-action="replacement_compare_click" data-action-kind="replacement">畳数で買い替えを比較する</a>`;
    }
    if (action.type === "article") {
      const title = articleTitleBySlug[action.slug] ?? action.slug;
      return `<a class="button secondary" href="${esc(basePath)}/articles/${esc(action.slug)}/"
        data-cvr-action="diagnosis_secondary_action_click" data-action-kind="safe">${esc(title)}を読む</a>`;
    }
    if (action.type === "danger-anchor") {
      return `<a class="button secondary" href="${esc(basePath)}/diagnosis/#danger-signs"
        data-cvr-action="diagnosis_danger_signs_click" data-action-kind="contractor">危険サインの一覧を見る</a>`;
    }
    return "";
  }

  function resultGuideHTML(node) {
    const guide = symptomGuides[node.symptom];
    if (!guide) return "";
    const resolvedCount = node.symptom === "cleaning" ? 2 : 1;
    const shownPossibilities = node.recommendation === "diy-wait"
      ? guide.possibilities.slice(0, resolvedCount)
      : guide.possibilities;
    const intro = node.recommendation === "diy-wait"
      ? "今回の確認で改善したことから、まず次の可能性が高そうです。再発する場合は、別の原因も含めて相談してください。"
      : guide.intro;
    const possibilities = shownPossibilities
      .map(
        (item) => `
          <article class="chat-possibility">
            <h4>${esc(item.title)}</h4>
            <p>${esc(item.mechanism)}</p>
            <p class="chat-professional-reason"><strong>一般の方が難しい理由</strong>${esc(item.professionalReason)}</p>
          </article>`
      )
      .join("");
    return `
      <section class="chat-result-guide" aria-label="ヒアリング時点で考えられる原因">
        <div class="chat-result-heading">
          <img src="${esc(resultStampImage)}" alt="親指を立てて確認完了を伝える風見先生のオリジナルスタンプ" loading="lazy" width="512" height="512" />
          <div>
            <span class="chat-result-eyebrow">風見先生の見立てメモ</span>
            <h3>ヒアリング時点で考えられること</h3>
            <p>${esc(intro)}</p>
          </div>
        </div>
        <div class="chat-possibilities">${possibilities}</div>
        <div class="chat-contact-memo">
          <strong>問い合わせ時に伝えること</strong>
          <p>${esc(guide.contactMemo)}</p>
        </div>
        <p class="chat-stamp-message">${esc(guide.stampMessage)}</p>
        <p class="chat-result-caution">これは画面上のヒアリングから考えられる一般的な可能性です。実際の原因は、現地での測定や点検によって判断されます。</p>
      </section>`;
  }

  function sleep(ms) {
    return new Promise((resolve) => setTimeout(resolve, ms));
  }

  function scrollToLatest() {
    logEl.scrollTop = logEl.scrollHeight;
  }

  // タイピングインジケーターをbubbleGroupに追加して返す
  function showTypingIn(bubbleGroup) {
    const el = document.createElement("div");
    el.className = "chat-typing";
    el.innerHTML = "<span></span><span></span><span></span>";
    bubbleGroup.appendChild(el);
    scrollToLatest();
    return el;
  }

  // 1吹き出しをアニメ付きで追加
  function appendBubble(bubbleGroup, html, isList) {
    const bubble = document.createElement("div");
    bubble.className = isList ? "chat-bubble chat-bubble-checklist" : "chat-bubble";
    bubble.innerHTML = html;
    bubbleGroup.appendChild(bubble);
    scrollToLatest();
  }

  async function appendNodeMessages(node) {
    const step = document.createElement("div");
    step.className = node.kind === "terminal" ? "chat-step terminal" : "chat-step";
    const row = document.createElement("div");
    row.className = "chat-row instructor";
    row.innerHTML = teacherHeaderHTML(node.teacher);
    const bubbleGroup = document.createElement("div");
    bubbleGroup.className = "chat-bubble-group";
    row.appendChild(bubbleGroup);
    step.appendChild(row);
    logEl.appendChild(step);
    stepEls.push(step);

    const bubbles = messagesToBubbles(node);
    const gapDelay = reducedMotion ? 0 : 90;

    // 文の長さに合わせて「考えてから話す」間を作る（一律の機械的な間にしない）
    const typingDurationFor = (html) => {
      if (reducedMotion) return 0;
      const textLength = html.replace(/<[^>]*>/g, "").length;
      return Math.min(900, 280 + textLength * 9);
    };

    for (let i = 0; i < bubbles.length; i++) {
      const { html, isList } = bubbles[i];
      const typingDelay = typingDurationFor(html);
      if (typingDelay > 0) {
        const typingEl = showTypingIn(bubbleGroup);
        await sleep(typingDelay);
        typingEl.remove();
      }
      appendBubble(bubbleGroup, html, isList);
      if (gapDelay > 0 && i < bubbles.length - 1) await sleep(gapDelay);
    }

    if (node.kind === "terminal" && !symptomGuides[node.symptom]) {
      if (gapDelay > 0) await sleep(gapDelay * 2);
      const guide = document.createElement("div");
      guide.innerHTML = resultGuideHTML(node);
      const guideSection = guide.firstElementChild;
      if (guideSection) bubbleGroup.appendChild(guideSection);
      scrollToLatest();
    }

    if (node.kind === "terminal" && node.actions.length > 0) {
      if (gapDelay > 0) await sleep(gapDelay * 2);
      const rec = node.recommendation;
      const toneClass = rec === "stop-call-pro" ? " danger" : "";
      const actionsDiv = document.createElement("div");
      actionsDiv.className = `chat-actions${toneClass}`;
      actionsDiv.innerHTML = node.actions.map(actionToAnchorHTML).join("");
      bubbleGroup.appendChild(actionsDiv);
      scrollToLatest();
    }

    // 終端は、風見先生らしい具体的なひとことで締める
    if (node.kind === "terminal") {
      const farewellPool = farewells[node.recommendation] ?? [];
      if (farewellPool.length > 0) {
        const farewellHtml = `<p>${esc(pick(farewellPool))}</p>`;
        const typingDelay = typingDurationFor(farewellHtml);
        if (typingDelay > 0) {
          await sleep(gapDelay * 3);
          const typingEl = showTypingIn(bubbleGroup);
          await sleep(typingDelay);
          typingEl.remove();
        }
        const bubble = document.createElement("div");
        bubble.className = "chat-bubble chat-bubble-farewell";
        bubble.innerHTML = farewellHtml;
        bubbleGroup.appendChild(bubble);
        scrollToLatest();
      }
    }
  }

  function renderReplies(node) {
    let chips = [];
    if (node.kind === "question") {
      chips = node.quickReplies.map((qr) => ({ label: qr.label, next: qr.next, kind: "advance" }));
    } else {
      chips = [
        { label: "別の症状を聞く", next: script.startNodeId, kind: "advance" },
        { label: "最初から", next: null, kind: "restart" }
      ];
    }
    repliesEl.innerHTML = chips
      .map(
        (c) =>
          `<button type="button" class="chat-chip" data-chip-kind="${c.kind}" ${
            c.next ? `data-next="${esc(c.next)}"` : ""
          } data-cvr-action="diagnosis_chat_reply_click" data-action-kind="safe">${esc(c.label)}</button>`
      )
      .join("");

    if (userInteracted) {
      const firstChip = repliesEl.querySelector(".chat-chip");
      if (firstChip) firstChip.focus();
    }
  }

  function updateControls() {
    backBtn.hidden = state.history.length === 0;
    restartBtn.hidden = state.history.length === 0;
  }

  async function renderNode(id) {
    const node = script.nodes[id];
    if (!node) return;
    state.currentId = id;
    await appendNodeMessages(node);
    renderReplies(node);
    updateControls();
    scrollToLatest();
  }

  function appendUserEcho(label) {
    const echo = document.createElement("div");
    echo.className = "chat-row user";
    echo.innerHTML = `<div class="chat-bubble user-bubble">${esc(label)}</div>`;
    logEl.appendChild(echo);
    echoEls.push(echo);
    scrollToLatest();
  }

  async function advance(next, echoLabel) {
    if (!script.nodes[next] || isAnimating) return;
    isAnimating = true;
    repliesEl.innerHTML = "";
    if (echoLabel) appendUserEcho(echoLabel);
    state.history.push(state.currentId);
    await renderNode(next);
    isAnimating = false;
  }

  function back() {
    if (state.history.length === 0 || isAnimating) return;
    const lastStep = stepEls.pop();
    if (lastStep) lastStep.remove();
    const lastEcho = echoEls.pop();
    if (lastEcho) lastEcho.remove();
    state.currentId = state.history.pop();
    renderReplies(script.nodes[state.currentId]);
    updateControls();
    scrollToLatest();
  }

  async function restart() {
    if (isAnimating) return;
    isAnimating = true;
    logEl.querySelectorAll(".chat-step, .chat-row.user").forEach((el) => el.remove());
    repliesEl.innerHTML = "";
    stepEls.length = 0;
    echoEls.length = 0;
    state.history = [];
    await renderNode(script.startNodeId);
    isAnimating = false;
  }

  repliesEl.addEventListener("click", async (event) => {
    const targetEl = event.target instanceof Element ? event.target : event.target?.parentElement;
    const chip = targetEl?.closest(".chat-chip");
    if (!chip || isAnimating) return;
    userInteracted = true;
    if (chip.dataset.chipKind === "restart") {
      await restart();
      return;
    }
    const next = chip.dataset.next;
    if (next) await advance(next, chip.textContent.trim());
  });

  backBtn.addEventListener("click", () => {
    userInteracted = true;
    back();
  });
  restartBtn.addEventListener("click", async () => {
    userInteracted = true;
    await restart();
  });

  // 初期化
  const symptomIds = new Set(
    Object.values(script.nodes)
      .filter((n) => n.symptom)
      .map((n) => n.symptom)
  );
  const hashId = location.hash.replace("#", "");

  async function startChat() {
    if (hasStarted) return;
    hasStarted = true;
    launchPanel?.remove();
    windowEl.hidden = false;
    controlsEl.hidden = false;
    const activeHashId = location.hash.replace("#", "");
    await renderNode(script.startNodeId);
    if (symptomIds.has(activeHashId)) {
      await advance(`${activeHashId}__danger-gate`, null);
    }
  }

  async function startSymptom(symptomId, echoLabel) {
    const nextId = `${symptomId}__danger-gate`;
    if (!script.nodes[nextId] || isAnimating) return;
    userInteracted = true;
    await startChat();
    if (state.currentId !== script.startNodeId || state.history.length > 0) {
      await restart();
    }
    await advance(nextId, echoLabel);
    const targetTop = rootEl.getBoundingClientRect().top + window.scrollY - 14;
    window.scrollTo({ top: Math.max(0, targetTop), behavior: reducedMotion ? "auto" : "smooth" });
  }

  launchBtn?.addEventListener("click", async () => {
    userInteracted = true;
    await startChat();
  });

  if (!isCompact) {
    window.addEventListener("diagnosis:symptom", (event) => {
      const detail = event.detail ?? {};
      startSymptom(detail.symptomId, detail.label);
    });
  }

  if (!isCompact) {
    document.addEventListener("click", (event) => {
      const targetEl = event.target instanceof Element ? event.target : event.target?.parentElement;
      if (!targetEl) return;
      const target = targetEl.closest('a[href="#chat-title"]');
      if (!target || !document.getElementById("chat-title")) return;
      setTimeout(() => {
        userInteracted = true;
        startChat();
      }, 0);
    });
  }

  if (rootEl.dataset.chatStartClosed !== "true" || symptomIds.has(hashId)) {
    startChat();
  }
</script>

<style>
  .chat {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .chat-intro {
    color: var(--muted);
    margin: 0;
  }

  .chat-launch {
    display: grid;
    gap: 12px;
    padding: 18px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background:
      linear-gradient(rgb(var(--brand-rgb) / 0.055) 1px, transparent 1px) 0 20px / 100% 30px,
      var(--paper);
    box-shadow: var(--shadow);
  }

  .chat-launch p {
    margin: 0;
    color: var(--muted);
    line-height: 1.7;
  }

  .chat-launch .button {
    justify-self: start;
  }

  .chat-window {
    border: 1px solid var(--line);
    border-radius: 8px;
    background:
      linear-gradient(rgb(var(--brand-rgb) / 0.045) 1px, transparent 1px) 0 20px / 100% 30px,
      var(--paper);
    overflow: hidden;
    box-shadow: var(--shadow);
  }

  .chat-window[hidden],
  .chat-controls[hidden] {
    display: none;
  }

  .chat-log {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-height: 560px;
    overflow-y: auto;
    padding: 20px 16px;
  }

  .chat-log :global(.chat-step) {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .chat-log :global(.chat-row) {
    display: flex;
    gap: 10px;
  }

  /* 先生＝左寄せ・アバターは最初の吹き出しの高さに合わせて上揃え */
  .chat-log :global(.chat-row.instructor) {
    justify-content: flex-start;
    align-items: flex-start;
  }

  /* 閲覧者＝右寄せ */
  .chat-log :global(.chat-row.user) {
    justify-content: flex-end;
    align-items: flex-end;
  }

