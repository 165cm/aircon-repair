---
import AmazonLink from "@components/AmazonLink.astro";
import type { ProductCategory } from "@data/products";
import { sitePath } from "@utils/paths";

type Props = {
  products: ProductCategory[];
  pageType?: string;
  linkPosition?: string;
};

const { products, pageType = "product-list", linkPosition = "list" } = Astro.props;
---

<ol class="product-table-list">
  {
    products.map((product, index) => (
      <li>
        <div class="product-table-row">
          <span class="product-table-number">{String(index + 1).padStart(2, "0")}</span>
          {product.image && <img src={sitePath(product.image)} alt="" loading="lazy" />}
          <div class="product-table-copy">
            <strong>{product.name}</strong>
            <span>{product.bestFor ?? product.description}</span>
            {product.priceBand && <small>{product.priceBand}</small>}
          </div>
          <div class="product-table-actions">
            <a
              class="inline-link"
              href={sitePath(`/products/${product.id}/`)}
              data-cvr-action="product_detail_click"
              data-action-kind={product.type === "replacement" ? "replacement" : "products"}
              data-slot-index={index + 1}
              data-item-id={product.id}
            >
              選び方
            </a>
            <AmazonLink
              product={product}
              pageType={pageType}
              linkPosition={`${linkPosition}-${product.id}`}
              label={product.type === "replacement" ? "候補を見る" : "価格を見る"}
              slotIndex={index + 1}
            />
          </div>
        </div>
      </li>
    ))
  }
</ol>
