{
  "name": "aircon-refuge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --host 127.0.0.1",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "postinstall": "node scripts/patch-rollup-wasm.mjs",
    "check:amazon": "node scripts/check-amazon-links.mjs",
    "generate:social": "node scripts/generate-social.mjs",
    "check:social": "node scripts/generate-social.mjs --check",
    "gsc:fetch": "node scripts/fetch-gsc.mjs",
    "gsc:ideas": "node scripts/gsc-content-ideas.mjs",
    "check:gsc": "node scripts/gsc-content-ideas.mjs --check",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview --host 127.0.0.1"
  },
  "dependencies": {
    "@rollup/wasm-node": "^4.60.4",
    "astro": "^5.0.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
